  habilitarRastreamentoDomingos              Boolean  @default(false) @map("habilitar_rastreamento_domingos")
  horarioInicioRastreamento                  String   @default("07:30") @map("horario_inicio_rastreamento") @db.VarChar(5)
  horarioTerminoRastreamento                 String   @default("18:00") @map("horario_termino_rastreamento") @db.VarChar(5)
  precisaoMinimaMetrosGps                    Int      @default(50) @map("precisao_minima_metros_gps")
  tempoMinimoAcordarGpsMs                    Int      @default(30000) @map("tempo_minimo_acordar_gps_ms")
  permitirRegistroComGpsDesabilitado         Boolean  @default(false) @map("permitir_registro_com_gps_desabilitado")
  distanciaMaximaClienteRegistroPedidoMetros Int?     @map("distancia_maxima_cliente_registro_pedido_metros")
  distanciaMaximaClienteRegistroVisitaMetros Int      @default(50) @map("distancia_maxima_cliente_registro_visita_metros")
