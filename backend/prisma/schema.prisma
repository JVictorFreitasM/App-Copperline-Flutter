generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SyncLogStatus {
  EM_ANDAMENTO
  SUCESSO
  ERRO

  @@map("sync_log_status")
}

model SyncEntity {
  id                  String    @id @default(uuid())
  nome                String    @unique
  ativo               Boolean   @default(true)
  // Inicio da janela [ultimaSincronizacao, agora] da proxima execucao -
  // gravado pelo SyncService so quando a busca no ERP (strategy.fetch)
  // completa sem erro, mesmo que registros individuais tenham falhado
  // depois (ver SyncService.executar).
  ultimaSincronizacao DateTime? @map("ultima_sincronizacao")
  criadoEm            DateTime  @default(now()) @map("criado_em")
  atualizadoEm        DateTime  @updatedAt @map("atualizado_em")

  logs SyncLog[]

  @@map("sync_entities")
}

model SyncLog {
  id                   String        @id @default(uuid())
  syncEntityId         String        @map("sync_entity_id")
  status               SyncLogStatus @default(EM_ANDAMENTO)
  iniciadoEm           DateTime      @default(now()) @map("iniciado_em")
  finalizadoEm         DateTime?     @map("finalizado_em")
  registrosProcessados Int           @default(0) @map("registros_processados")
  registrosComErro     Int           @default(0) @map("registros_com_erro")
  erro                 Json?
  // Avisos nao-fatais (ex: suspeita de truncamento silencioso numa
  // sub-janela de paginacao - ver skill wk-radar-client, secao
  // "Paginacao"). Lista de strings; null quando nao ha nenhum.
  avisos               Json?

  syncEntity SyncEntity @relation(fields: [syncEntityId], references: [id])

  @@index([syncEntityId])
  @@map("sync_logs")
}

// Sincronizado do WK Radar (GET /empresarial/v1/cliente) - so leitura, ver
// skill wk-radar-client. codigoIntegrador existe desde ja para quando
// houver escrita de volta no ERP (fora de escopo nesta OS).
model Cliente {
  id                String   @id @default(uuid())
  idExternoErp      String   @unique @map("id_externo_erp")
  codigoIntegrador  String?  @map("codigo_integrador")
  cpfCnpj           String?  @map("cpf_cnpj")
  razaoSocial       String?  @map("razao_social")
  nomeFantasia      String?  @map("nome_fantasia")
  // inscricoesLegais.inscricaoEstadual no WK Radar (confirmado contra a API
  // real, 2026-09-28) - pedido pro PDF de impressao do pedido (IE do
  // cliente no bloco de identificacao).
  inscricaoEstadual String?  @map("inscricao_estadual")
  // Dados de contato/identificacao do cadastro do cliente no WK Radar
  // (card de apresentacao do detalhe do cliente): `codigo` e' o codigo
  // exibido ao usuario no ERP (ex: "10458"), diferente de `idExternoErp`
  // (chave interna do Radar); email/contato/homepage sao do cadastro em si,
  // separados dos contatos (ContatoCliente) e do email/telefones de cada
  // endereco (que ficam dentro de `enderecos`).
  codigo            String?
  email             String?
  contato           String?
  homepage          String?
  inativo           Boolean  @default(false)
  // Enderecos nao tem id/codigoIntegrador proprio no WK Radar (ao contrario
  // de contatos) - sem identidade propria pra preservar, JSONB e suficiente.
  enderecos         Json     @default("[]")
  // true quando esta linha foi criada como stub por PedidoSyncStrategy (OS
  // 07, pedido referenciando um cliente ainda nao sincronizado) - clienteSync
  // sempre grava false ao completar os dados de verdade, seja criando ou
  // atualizando.
  incompleto        Boolean  @default(false)
  sincronizadoEm    DateTime @map("sincronizado_em")

  // Dados financeiros embutidos no proprio cadastro do cliente no WK Radar
  // (informacoesFinanceiras) - vem junto do sync normal, sem chamada extra
  // (OS-BACKEND-36). O DTO do Radar tambem tem descontoFinanceiro/desconto,
  // mas so limiteCredito foi pedido pela OS - os demais ficam fora de
  // escopo. Inadimplencia/notas em aberto NAO vem daqui: sao consultadas
  // sob demanda em /api/financeiro/v1/titulo-contas-receber (ver
  // ClienteFinanceiroService) - endpoint separado, sem persistir localmente
  // (dado transacional que muda com cada pagamento).
  limiteCredito     Decimal?  @map("limite_credito") @db.Decimal(14, 2)
  dataLimiteCredito DateTime? @map("data_limite_credito")

  // Tabela de preco NATIVA do cadastro do cliente no Radar
  // (informacoesExtras2.idTabelaPrecoProduto - achado em 2026-09-17,
  // schema real confirmado pelo usuario). ID EXTERNO (nao codigo) porque
  // e' exatamente o que o Radar devolve - resolvido pro `codigo` de
  // TabelaPreco so' na LEITURA (ClienteTabelaPrecoService), mesmo criterio
  // de bootstrap ja documentado em ClienteTabelaPreco (a linha de
  // TabelaPreco pode nao existir ainda quando o cliente sincroniza).
  // Usado como FALLBACK quando o cliente nao tem nenhuma linha manual em
  // ClienteTabelaPreco (admin nunca associou) - nao substitui a decisao
  // manual do admin quando ela existir.
  tabelaPrecoIdExterno String? @map("tabela_preco_id_externo")

  // "Pin" de localizacao (visita com foto/geolocalizacao, extensao da
  // OS-BACKEND-28) - NAO vem do WK Radar (o endereco em `enderecos` acima
  // e' o cadastral, sem coordenada). Definido manualmente por um vendedor
  // vinculado ao cliente via PATCH /clientes/:id/localizacao, uma vez
  // (redefinivel depois). Serve de referencia pra validar que check-in e
  // checkout de visita aconteceram a ate 50m de distancia (ver
  // VisitasService, domain/distancia-geografica.ts) - sem pin definido,
  // check-in fica bloqueado (nao ha o que validar contra).
  localizacaoLat           Decimal?  @map("localizacao_lat") @db.Decimal(9, 6)
  localizacaoLng           Decimal?  @map("localizacao_lng") @db.Decimal(9, 6)
  localizacaoDefinidaEm    DateTime? @map("localizacao_definida_em")
  localizacaoDefinidaPorId String?   @map("localizacao_definida_por_id")

  contatos               ContatoCliente[]
  pedidos                Pedido[]
  vendedores             ClienteVendedor[]
  visitas                Visita[]
  tabelasPreco           ClienteTabelaPreco[]
  agendamentosVisita     AgendamentoVisita[]
  localizacaoDefinidaPor Vendedor?            @relation("ClienteLocalizacaoDefinidaPor", fields: [localizacaoDefinidaPorId], references: [id])

  @@map("clientes")
}

// N:N cliente<->tabela de preco (OS-novas-implementacoes.md Bloco 1) -
// decisao confirmada com o usuario (simplifica a proposta original da OS,
// que cogitava tambem restringir por vendedor): o admin decide quais
// tabelas um cliente tem (1 ou mais). Com 1 so', o vendedor nao escolhe
// ("fixa"); com 2+, QUALQUER vendedor que atenda aquele cliente ve' todas
// as tabelas associadas e escolhe entre elas - sem camada extra de
// visibilidade por vendedor. Cliente SEM nenhuma linha aqui cai no
// fallback global antigo (ConfiguracaoTabelaPreco.codigoSelecionado, ver
// PrecoProdutoService) - decisao confirmada, nao quebra cliente ainda nao
// migrado pra essa feature.
//
// codigo (String), NAO tabelaPrecoId (FK) - mesmo criterio ja usado em
// ConfiguracaoTabelaPreco.codigoSelecionado: a linha de TabelaPreco so'
// existe DEPOIS de sincronizada (upsert por idExternoErp do Radar) - uma
// FK aqui criaria um problema de bootstrap (admin associando um codigo
// que o sync ainda nunca buscou). O proprio sync (tabela-preco.sync.ts)
// passa a acompanhar todo codigo referenciado aqui, alem do global.
model ClienteTabelaPreco {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  codigo    String
  criadoEm  DateTime @default(now()) @map("criado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, codigo])
  @@map("clientes_tabelas_preco")
}

// N:N (OS-BACKEND-23) - o WK Radar modela vinculo de cliente com vendedor
// como detalhes.idVendedores, um ARRAY (confirmado contra o swagger.json
// do ambiente de testes) - um cliente pode ter mais de um vendedor
// vinculado (raro na pratica, mas possivel - decisao confirmada com o
// usuario). Por isso NAO e' um campo unico vendedorResponsavelId em
// Cliente como o texto original da OS sugeria, e sim esta tabela de
// vinculo, recriada do zero a cada sync (delete+recreate por clienteId -
// mesmo padrao ja usado em NotaFiscalPedido, ver nota-fiscal.sync.ts) em
// vez de tentar diffar contra o estado anterior.
model ClienteVendedor {
  id         String   @id @default(uuid())
  clienteId  String   @map("cliente_id")
  vendedorId String   @map("vendedor_id")
  criadoEm   DateTime @default(now()) @map("criado_em")

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@unique([clienteId, vendedorId])
  @@index([vendedorId])
  @@map("clientes_vendedores")
}

// Contatos tem identidade propria no WK Radar (id + codigoIntegrador
// proprios), por isso viram tabela relacionada em vez de ficarem
// embutidos no JSON do cliente (decisao desta OS, ver README do sync).
model ContatoCliente {
  id               String   @id @default(uuid())
  idExternoErp     String   @unique @map("id_externo_erp")
  codigoIntegrador String?  @map("codigo_integrador")
  clienteId        String   @map("cliente_id")
  nome             String?
  email            String?
  telefoneDdd      String?  @map("telefone_ddd")
  telefoneNumero   String?  @map("telefone_numero")
  funcao           String?
  sincronizadoEm   DateTime @map("sincronizado_em")

  // Contato criado por nos (POST /clientes/:id/contatos, criacao de
  // pedido) - idExternoErp recebe um valor sintetico ("LOCAL-<uuid>") pra
  // preservar a unicidade da coluna sem torna-la nullable. Nunca sobe pro
  // WK Radar (fluxo de escrita de volta e' sempre separado, ver
  // schema.prisma no topo) - ClienteSyncStrategy.upsert so' itera
  // contatos vindos do Radar, entao uma linha local nunca e' tocada por
  // ele (sem guard extra necessario).
  criadoLocalmente Boolean @default(false) @map("criado_localmente")

  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([clienteId])
  @@map("contatos_clientes")
}

enum TipoProduto {
  INVALIDO
  CLASSE
  PROPRIO
  TERCEIROS
  KIT

  @@map("tipo_produto")
}

// Sincronizado do WK Radar (GET /empresarial/v1/produto) - so leitura, ver
// skill wk-radar-client. kit[] e blocos fiscais extensos (ipi,
// aliquotasICMS, produtoPISCOFINS) ficam fora por enquanto (OS 06) - so
// mapear se/quando o sistema precisar exibir isso.
//
// Decisao de grade (OS 06): idGrade1/2/3 (dimensoes, ex: cor/tamanho) e
// referenciasGrade[] (combinacoes especificas) NAO tem id/codigoIntegrador
// proprio no WK Radar - igual a "enderecos" em Cliente, sem identidade
// propria pra preservar. Por isso cada combinacao de grade NAO vira linha
// propria; fica embutida como JSONB no produto base. A chave de upsert
// continua sendo so id_externo_erp (id do produto base no WK Radar), sem
// incluir niveis de grade.
model Produto {
  id               String       @id @default(uuid())
  idExternoErp     String       @unique @map("id_externo_erp")
  codigoIntegrador String?      @map("codigo_integrador")
  codigo           String?
  nome             String?
  descricao        String?
  tipo             TipoProduto?
  inativo          Boolean      @default(false)
  precoVenda       Decimal?     @map("preco_venda") @db.Decimal(18, 6)
  gtin             String?
  idGrade1         String?      @map("id_grade_1")
  idGrade2         String?      @map("id_grade_2")
  idGrade3         String?      @map("id_grade_3")
  referenciasGrade Json         @default("[]") @map("referencias_grade")
  // true quando esta linha foi criada como stub por PedidoSyncStrategy (OS
  // 07, item de pedido referenciando um produto ainda nao sincronizado) -
  // produtoSync sempre grava false ao completar os dados de verdade.
  incompleto       Boolean      @default(false)
  sincronizadoEm   DateTime     @map("sincronizado_em")

  // Comprimento por peca/unidade fechada (OS-BACKEND-24), mapeado de
  // dimensoes.comprimento do WK Radar - so quando
  // dimensoes.unidadeMedidaComprimento e' "Metro" (valor exato do enum
  // ainda NAO confirmado contra o ambiente real - ver comentario em
  // produto.sync.ts); em qualquer outro caso fica null (fail-safe, nunca
  // interpreta um valor errado como metro). Usado por
  // calcularQuantidadePedido pra POC/KM - RET nao depende disso.
  comprimentoMetros Decimal? @map("comprimento_metros") @db.Decimal(10, 3)

  // PENDENCIA (OS-BACKEND-24): origem/regra de classificacao (campo nativo
  // do Radar `classificacao` vs. calculo local a partir de
  // comprimentoMetros, incluindo o corte exato entre 30-50m) NAO foi
  // confirmada com quem define a regra de negocio - decisao explicita de
  // deixar como pendencia por enquanto. Nullable, sem populacao automatica
  // nem endpoint de atribuicao manual ainda - so o campo existe, pronto
  // pra ser preenchido quando a regra for definida.
  tipoVenda TipoVendaProduto? @map("tipo_venda")

  // Campos abaixo NAO vem do WK Radar (nao sincronizados) - dado proprio
  // do sistema, preenchido manualmente via PATCH /produtos/:id. Por nao
  // fazerem parte do `campos` mapeado em produto.sync.ts, o upsert de sync
  // nunca os sobrescreve.
  //
  // precoFabricacao: pedido do usuario ("mostrar preco de fabricacao") -
  // o Radar nao expoe custo/fabricacao no cadastro de produto (so
  // precoVenda), por isso e' um campo nosso, editavel manualmente.
  precoFabricacao        Decimal?              @map("preco_fabricacao") @db.Decimal(18, 6)
  // Caminho no disco do servidor (mesmo padrao de armazenamento local ja
  // usado por DocumentoStorageService/VisitaFotoStorageService) - so web
  // tem UI de upload (pedido do usuario), mas o campo/endpoint fica no
  // backend compartilhado, sem trava tecnica que impeça o mobile de usar
  // no futuro.
  imagemCaminho          String?               @map("imagem_caminho")
  imagemTipoMime         String?               @map("imagem_tipo_mime")
  // Catalogo proprio (nao vem do Radar), editavel pelo admin - ver
  // TipoAcondicionamento abaixo.
  tipoAcondicionamentoId String?               @map("tipo_acondicionamento_id")
  tipoAcondicionamento   TipoAcondicionamento? @relation(fields: [tipoAcondicionamentoId], references: [id])

  // Peso liquido/bruto (OS-novas-implementacoes.md Bloco 3) - VEM do WK
  // Radar (campos de nivel superior `pesoLiquido`/`pesoBruto`, confirmado
  // empiricamente contra a API real - NAO fica dentro de `dimensoes` como
  // comprimento), mapeado em produto.sync.ts so quando a unidade
  // (`unidadeMedidaPesoLiquido`/`unidadeMedidaPesoBruto`) e' exatamente
  // "kg" (mesmo criterio fail-safe de comprimentoMetros - qualquer outra
  // unidade fica null, nunca interpretada errado). Peso da PECA/unidade de
  // venda (nao taxa por metro - decisao confirmada com o usuario): pra
  // somar no pedido, multiplica por PedidoItem.quantidadeVenda, nao pelos
  // metros pedidos.
  pesoLiquidoKg Decimal? @map("peso_liquido_kg") @db.Decimal(12, 3)
  pesoBrutoKg   Decimal? @map("peso_bruto_kg") @db.Decimal(12, 3)

  itensPedido PedidoItem[]
  favoritos   ProdutoFavorito[]

  @@map("produtos")
}

// Catalogo extensivel de tipo de acondicionamento (OS-novas-implementacoes.md
// Bloco 4) - NAO sincronizado do Radar (dado proprio do sistema, mesmo
// criterio de precoFabricacao/imagemCaminho acima), cadastravel pelo admin
// em runtime sem precisar de deploy (diferente de um enum fixo tipo
// TipoVendaProduto).
model TipoAcondicionamento {
  id            String   @id @default(uuid())
  nome          String
  ativo         Boolean  @default(true)
  // OS-novas-implementacoes.md Bloco 4 (revisao) - null = retalho (corte
  // fracionario livre); preenchido = tamanho fixo, pedido tem que ser
  // multiplo exato deste valor (calcularQuantidadePedido bloqueia caso
  // contrario). "Multiplo" (ex: rolo de 100m) e "unidade" (peca fechada,
  // tamanhoPadrao=1) sao o mesmo calculo - decisao confirmada com o
  // usuario de nao ter um campo de "modo" separado. Pertence ao TIPO, nao
  // ao produto (decisao confirmada) - produtos do mesmo tipo compartilham
  // o mesmo tamanho padrao.
  tamanhoPadrao Decimal? @map("tamanho_padrao") @db.Decimal(10, 3)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  produtos Produto[]

  @@map("tipos_acondicionamento")
}

// Sincronizada via Empresarial.svc/BuscarTabelasPreco (WCF legado, mesma
// familia de Estoque.svc/Financeiro.svc - ver empresarial-svc-client).
// Decisao revisada com o usuario: NAO faz mais full refresh (`filtro:{}`,
// todas as tabelas) - confirmado empiricamente que isso leva 90-190s so'
// na chamada, contra poucos segundos consultando UM codigo especifico
// (mesma operacao, `filtro:{Codigo: x}`). O sync agora busca so' o codigo
// configurado em ConfiguracaoTabelaPreco.codigoSelecionado - sem selecao,
// nao sincroniza nada (ver TabelaPrecoSyncStrategy.fetch). CodigoItem de
// cada item corresponde a Produto.codigo, mas SEM FK direta (mesmo motivo
// de SaldoEstoque - tabela de preco pode referenciar item nao
// sincronizado como Produto ainda).
model TabelaPreco {
  id           String  @id @default(uuid())
  // ID do SOAP Empresarial.svc (BuscarTabelasPreco) - so' serve pra casar
  // upsert dos ITENS/precos (ItemTabelaPreco), sincronizados por esse
  // mesmo servico. NUNCA usar este campo como idTabelaPreco no payload de
  // POST /comercial/v1/pedido - e' um namespace de ID DIFERENTE do REST
  // (achado em 2026-09-17: Radar tem dois sistemas de tabela de preco com
  // IDs incompativeis entre si - confirmado testando contra o ambiente
  // real, "Id: 58" do SOAP nao existe no espaco REST). Ver
  // idVendaProdutoExterno abaixo pra esse caso.
  idExternoErp String  @unique @map("id_externo_erp")
  codigo       String  @unique
  ativa        Boolean @default(true)

  // ID do REST /empresarial/v1/tabela-preco-venda-produto (mesmo namespace
  // usado por POST /comercial/v1/pedido, itens[].idTabelaPreco, e por
  // Cliente.tabelaPrecoIdExterno) - o campo que REALMENTE deve ir no
  // payload de criacao de pedido. Nullable: so' preenchido depois que
  // tabela-preco.sync.ts busca esse endpoint pra cada codigo rastreado
  // (pode nao ter sido preenchido ainda pra tabela sincronizada antes
  // desta OS).
  idVendaProdutoExterno String? @map("id_venda_produto_externo")

  sincronizadoEm DateTime @map("sincronizado_em")

  itens ItemTabelaPreco[]

  @@map("tabelas_preco")
}

// Singleton (1 linha) - qual codigo de tabela de preco o sync deve
// acompanhar (pedido do usuario: "pegue apenas a tabela 110, o sync das
// outras só vai acontecer se ela for selecionada"). Escolher aqui e' o
// que TAMBEM define a fonte de preco "oficial" pro resto do sistema
// (PrecoProdutoService) - uma unica decisao, nao duas separadas.
model ConfiguracaoTabelaPreco {
  id                String   @id @default(uuid())
  codigoSelecionado String?  @map("codigo_selecionado")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_tabela_preco")
}

model ItemTabelaPreco {
  id            String @id @default(uuid())
  tabelaPrecoId String @map("tabela_preco_id")
  codigoItem    String @map("codigo_item")

  preco                    Decimal   @db.Decimal(18, 6)
  precoPromocional         Decimal?  @db.Decimal(18, 6)
  quantidadeMinima         Decimal   @db.Decimal(20, 4)
  quantidadeMaxima         Decimal   @db.Decimal(20, 4)
  percentualDescontoMaximo Decimal   @db.Decimal(5, 2)
  valorDescontoMaximo      Decimal   @db.Decimal(18, 6)
  dataUltimoReajuste       DateTime? @map("data_ultimo_reajuste")
  dataInicioPromocao       DateTime? @map("data_inicio_promocao")
  dataFimPromocao          DateTime? @map("data_fim_promocao")

  tabelaPreco TabelaPreco @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)

  @@unique([tabelaPrecoId, codigoItem])
  @@index([codigoItem])
  @@map("itens_tabela_preco")
}

enum TipoVendaProduto {
  POC
  RET
  KM

  @@map("tipo_venda_produto")
}

enum TipoSituacaoPedido {
  EM_ANALISE
  BLOQUEADO
  PENDENTE
  CANCELADO
  PARCIALMENTE_FATURADO
  FATURADO
  PARCIALMENTE_ATENDIDO
  ATENDIDO

  @@map("tipo_situacao_pedido")
}

enum SituacaoItemPedido {
  NENHUM
  CANCELADO
  FATURADO
  PARCIALMENTE_FATURADO
  ATENDIDO
  PARCIALMENTE_ATENDIDO
  PENDENTE

  @@map("situacao_item_pedido")
}

// Sincronizado do WK Radar (GET /comercial/v1/pedido) - so leitura, ver
// skill wk-radar-client. Blocos extensos de tributos/rateios/liberacoes de
// estoque por item ficam fora (OS 07) - so mapear se/quando o sistema
// precisar exibir isso, mesmo criterio ja aplicado a produto.
//
// Referencia a cliente (OS 07): idCliente e opcional (nullable) porque um
// pedido pode chegar antes do cliente correspondente ter sido sincronizado
// (ordem de sync nao e garantida entre entidades independentes, so a ordem
// de dependencia LOGICA foi pensada nas OSs - ver dependencias da OS 07).
// Em vez de pular o pedido (o que o perderia permanentemente: o cursor de
// sync avanca mesmo com erro pontual - ver SyncService - entao um pedido
// pulado nunca mais apareceria numa janela futura), PedidoSyncStrategy cria
// um Cliente STUB (incompleto=true) com so o id_externo_erp, satisfazendo a
// FK imediatamente. Quando cliente.sync.ts sincronizar esse cliente de
// verdade (em qualquer execucao futura), o upsert por id_externo_erp
// completa os dados e zera incompleto - sem exigir nenhuma acao retroativa
// no pedido. Mesma logica pra ProdutoSyncStrategy resolvendo produto: em
// PedidoItem.produtoId.
model Pedido {
  id                      String              @id @default(uuid())
  // Nullable (OS-BACKEND-25) - so os pedidos SINCRONIZADOS do ERP tem
  // idExternoErp desde a criacao da linha; um pedido criado LOCALMENTE
  // (POST /pedidos) comeca sem ele (ainda nao existe no Radar) e so ganha
  // valor apos o envio confirmar sucesso. Postgres permite varios NULL
  // numa coluna @unique, entao isso nao quebra a unicidade pros pedidos
  // que ja tem id real.
  idExternoErp            String?             @unique @map("id_externo_erp")
  // Data EFETIVA do pedido pra ordenar a listagem - coluna GERADA pelo banco
  // (coalesce(data_hora_ultima_alteracao, data_emissao, sincronizado_em), ver
  // migration 20261002120000) - NUNCA escrita pelo app. Existe porque
  // ordenar por dataHoraUltimaAlteracao + sincronizadoEm jogava pedido local
  // recem-criado pro meio da lista: o sync regrava sincronizado_em de TODOS
  // os pedidos a cada rodada, e pedido do Radar sem data de alteracao passava
  // na frente.
  dataOrdenacao           DateTime?           @map("data_ordenacao")
  codigoIntegrador        String?             @map("codigo_integrador")
  numero                  String?
  situacao                TipoSituacaoPedido?
  dataHoraUltimaAlteracao DateTime?           @map("data_hora_ultima_alteracao")
  clienteId               String?             @map("cliente_id")
  valorTotal              Decimal?            @map("valor_total") @db.Decimal(18, 6)

  // Tela de listagem web (layout de referencia) - "Data de Criacao" da
  // tabela. Mapeado do Radar (dataEmissao, formato DD/MM/YYYY) - so pedido
  // sincronizado tem; pedido criado local usa a data de criacao real (ver
  // CriarPedidoService).
  dataEmissao     DateTime? @map("data_emissao")
  // UF do endereco de entrega (filtro "Localizacao") - derivado do
  // idMunicipio do Radar (codigo IBGE de 7 digitos, os 2 primeiros
  // identificam a UF - tabela estatica, sem sync de um catalogo de
  // municipios). So ~7% dos pedidos tem localEntrega preenchido no Radar -
  // fica null pra maioria, esperado (nao e falha de sync).
  ufEntrega       String?   @map("uf_entrega") @db.VarChar(2)
  // Vendedor do PRÓPRIO pedido sincronizado (Radar `pedido.vendedores[0].id`,
  // resolvido contra Vendedor.idExternoErp) - conceito DIFERENTE de
  // `vendedorId` acima (que so existe pra pedido criado localmente por
  // este sistema, e significa "quem criou"). Null quando o Radar nao
  // informa vendedor OU o vendedor referenciado ainda nao foi sincronizado
  // (nunca cria stub aqui - Vendedor tem campos de autenticacao vinculados,
  // diferente do stub simples de Cliente/Produto).
  vendedorRadarId String?   @map("vendedor_radar_id")
  // true quando esta linha foi criada como stub por NotaFiscalSyncStrategy
  // (OS 09, nota fiscal referenciando um pedido ainda nao sincronizado) -
  // pedidoSync sempre grava false ao completar os dados de verdade. Mesmo
  // padrao ja usado em Cliente/Produto (OS 07). NAO e' o mesmo conceito de
  // um pedido criado localmente (ver vendedorId/statusLocal abaixo) - um
  // pedido local tem dado completo do nosso lado, so ainda nao tem
  // situacao/numero do Radar.
  incompleto      Boolean   @default(false)
  sincronizadoEm  DateTime  @map("sincronizado_em")

  // Origem local (OS-BACKEND-25, POST /pedidos) - null pra pedidos que so
  // existem por sincronizacao (nunca criados pelo nosso sistema).
  // vendedorId e' de quem o pedido E' (responsavel) - normalmente quem
  // criou, mas supervisor/gerente pode escolher um vendedor da propria
  // equipe na criacao (ver CriarPedidoDto.vendedorId, validado contra
  // VendedorEscopoService antes de aceitar). statusLocal controla o gate
  // de aprovacao de desconto (ver CriarPedidoService) - PENDENTE nunca foi
  // enviado ao ERP, ENVIADO ja foi confirmado (idExternoErp preenchido).
  // Sem status "ERRO_ENVIO" de proposito: se o envio falha, a linha
  // inteira e' descartada (nunca persistida) em vez de marcada com erro -
  // ver criterio de aceite "sem deixar registro orfao no banco local".
  vendedorId                   String?            @map("vendedor_id")
  percentualDescontoSolicitado Decimal?           @map("percentual_desconto_solicitado") @db.Decimal(5, 2)
  statusLocal                  StatusPedidoLocal? @map("status_local")

  // Tabela de precos escolhida na criacao (popup, ver
  // OS-pendentes-claude-code.md) - persistida por auditoria (saber depois
  // qual tabela precificou o pedido; sem isso so' se sabe qual tabela esta'
  // configurada HOJE, nao a de quando o pedido foi feito). Nullable -
  // pedido sincronizado do Radar nunca passa por aqui.
  codigoTabelaPreco String? @map("codigo_tabela_preco")
  // Contato do cliente escolhido na criacao - opcional (nem todo pedido
  // precisa de um contato especifico). Nullable tambem pra pedido
  // sincronizado.
  contatoId         String? @map("contato_id")

  // Peso total do pedido (OS-novas-implementacoes.md Bloco 3) - soma de
  // Produto.pesoLiquidoKg/pesoBrutoKg * PedidoItem.quantidadeVenda de cada
  // item, calculado e CONGELADO na criacao (CriarPedidoService), mesmo
  // criterio ja usado por valorTotal (nunca recalculado a cada leitura).
  // Null quando QUALQUER item do pedido tem produto sem peso cadastrado -
  // um total parcial seria enganoso (nunca expor peso "quase completo"
  // como se fosse o total real). So calculado pra pedido criado local
  // (POST /pedidos) - pedido sincronizado do ERP nao passa por aqui.
  pesoLiquidoTotalKg Decimal? @map("peso_liquido_total_kg") @db.Decimal(14, 3)
  pesoBrutoTotalKg   Decimal? @map("peso_bruto_total_kg") @db.Decimal(14, 3)

  // Escolha do vendedor na criacao (POST /pedidos, CriarPedidoService) -
  // persistida independente do pedido ter sido enviado ao ERP na hora
  // (statusLocal ENVIADO) ou ficado AGUARDANDO_APROVACAO: sem isso, a
  // escolha se perderia pro caso de aprovacao posterior (fluxo de "enviar
  // ao ERP depois de aprovado" ainda nao implementado - ver
  // OS-pendentes-claude-code.md). Nullable pra pedido sincronizado do ERP
  // (nunca passa por aqui).
  formaPagamentoId    String? @map("forma_pagamento_id")
  condicaoPagamentoId String? @map("condicao_pagamento_id")

  // Observacoes do pedido (2026-09-21, pedido do usuario) - campo do
  // PEDIDO inteiro, nao por item (ver PedidoItem.observacoes, conceito
  // separado e ja existente). Preenchido na criacao (POST /pedidos),
  // exibido em GET /pedidos/:id. Nullable tambem pra pedido sincronizado
  // do Radar (o Radar nao expoe observacao livre no schema confirmado ate
  // agora, ver skill wk-radar-client).
  observacoes String? @db.Text

  cliente              Cliente?                @relation(fields: [clienteId], references: [id])
  vendedor             Vendedor?               @relation(fields: [vendedorId], references: [id])
  vendedorRadar        Vendedor?               @relation("PedidoVendedorRadar", fields: [vendedorRadarId], references: [id])
  formaPagamento       FormaPagamento?         @relation(fields: [formaPagamentoId], references: [id])
  condicaoPagamento    CondicaoPagamento?      @relation(fields: [condicaoPagamentoId], references: [id])
  contato              ContatoCliente?         @relation(fields: [contatoId], references: [id])
  itens                PedidoItem[]
  notasFiscais         NotaFiscalPedido[]
  solicitacoesDesconto SolicitacaoDesconto[]
  historicoStatus      PedidoHistoricoStatus[]

  @@index([clienteId])
  @@map("pedidos")
}

enum StatusPedidoLocal {
  AGUARDANDO_APROVACAO
  ENVIADO
  // Epico 4 (config-aba-orcamento.jpg) - rascunho local, nunca chegou no
  // ERP e nunca passou pela avaliacao de desconto (isso so acontece
  // quando o orcamento e' "transformado" num pedido de verdade, ver
  // CriarPedidoService.transformarEmPedido). Cancelar um orcamento
  // (nunca chegou no ERP) apaga a linha por completo, nao vira um
  // status novo - mesmo espirito de "sem deixar registro orfao" ja
  // usado pro envio que falha.
  ORCAMENTO
  // Todos os itens com desconto acima da alcada foram RECUSADOS pelo
  // aprovador - o pedido inteiro e' cancelado e nada vai ao Radar (ver
  // DecisaoDescontoPedidoService). Fica gravado (nao apaga) pra historico
  // e pra notificar o vendedor.
  CANCELADO

  @@map("status_pedido_local")
}

// Rastreabilidade de status do pedido (OS-BACKEND-33) - statusAnterior/
// statusNovo sao texto livre (nao um enum unico), de proposito: cobrem
// tanto StatusPedidoLocal (ENVIADO/AGUARDANDO_APROVACAO, na criacao) quanto
// o resultado da decisao de desconto (APROVADO/REJEITADO, ver
// SolicitacoesDescontoService.decidir) - dois vocabularios diferentes sobre
// o mesmo pedido, sem um enum comum que faca sentido pros dois. alteradoPor
// nullable so pro caso (hoje inexistente na pratica) de uma transicao sem
// ator humano identificavel - toda transicao ja implementada tem um
// usuarioId real (quem criou o pedido, quem decidiu a solicitacao).
model PedidoHistoricoStatus {
  id             String   @id @default(uuid())
  pedidoId       String   @map("pedido_id")
  statusAnterior String?  @map("status_anterior")
  statusNovo     String   @map("status_novo")
  alteradoPor    String?  @map("alterado_por")
  alteradoEm     DateTime @default(now()) @map("alterado_em")

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [alteradoPor], references: [id])

  @@index([pedidoId])
  @@map("pedido_historico_status")
}

// Itens de pedido NAO tem id/codigoIntegrador proprio no WK Radar (so
// `numero`, a posicao do item dentro do pedido) - diferente de contatos,
// sem identidade externa pra usar como chave de upsert. A chave de upsert e
// o par (pedidoId, numero).
//
// Referencia a produto (OS 07, ver nota da skill wk-radar-client sobre
// "Sistema de grade"): produtoServico do WK Radar identifica o item pela
// combinacao id + idItemGrade1/2/3, nao so pelo id do produto base. Como a
// OS 06 decidiu nao criar uma linha por combinacao de grade (referenciasGrade
// fica embutido como JSONB em Produto), o FK produtoId aponta pro produto
// BASE (Produto.idExternoErp = produtoServico.id) e idItemGrade1/2/3 ficam
// gravados aqui so como colunas descritivas (qual combinacao foi pedida),
// nao como parte da chave de relacionamento.
// Tela de detalhe do pedido (layout de referencia ref1.jpeg) - aprovacao
// GRANULAR por item, conceito NOVO e distinto de SolicitacaoDesconto (que
// decide o pedido INTEIRO de uma vez, ligado ao limite de desconto - ver
// solicitacao-desconto.entity.ts). Aqui e' uma revisao mais simples, sem
// regra de hierarquia/autoaprovacao: qualquer usuario com escopo sobre o
// pedido (mesmo EscopoClientes ja usado em PedidosService) pode decidir um
// item, sem exigir papel especifico nem bloquear autoaprovacao - por isso
// fica direto no service, sem entidade de dominio propria (ver skill
// nestjs, "DDD so onde ha regra de negocio real").
enum StatusAprovacaoItemPedido {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("status_aprovacao_item_pedido")
}

model PedidoItem {
  id              String              @id @default(uuid())
  pedidoId        String              @map("pedido_id")
  numero          Int
  produtoId       String?             @map("produto_id")
  idItemGrade1    String?             @map("id_item_grade_1")
  idItemGrade2    String?             @map("id_item_grade_2")
  idItemGrade3    String?             @map("id_item_grade_3")
  quantidadeVenda Decimal?            @map("quantidade_venda") @db.Decimal(18, 6)
  valorUnitario   Decimal?            @map("valor_unitario") @db.Decimal(18, 6)
  valorTotal      Decimal?            @map("valor_total") @db.Decimal(18, 6)
  situacao        SituacaoItemPedido?
  sincronizadoEm  DateTime            @map("sincronizado_em")

  // Desconto por item (OS-pendentes-claude-code.md) - so' preenchido pra
  // item criado localmente (CriarPedidoService); item sincronizado do
  // Radar nunca passa por aqui. valorUnitarioBruto e' o preco de tabela
  // ANTES do desconto (necessario pra reexibir "De/Por" depois sem
  // derivar de tras pra frente com perda de precisao - valorUnitario
  // acima ja e' o preco COM desconto aplicado).
  percentualDesconto Decimal? @map("percentual_desconto") @db.Decimal(5, 2)
  valorUnitarioBruto Decimal? @map("valor_unitario_bruto") @db.Decimal(18, 6)
  observacoes        String?

  // Congelado na criacao (2026-09-21, mesmo criterio de valorUnitarioBruto
  // acima - nunca recalculado depois) - 'METRO' (retalho, quantidadeVenda
  // em KM) ou 'PECA' (rolo/peca fechada, quantidadeVenda em contagem).
  // Necessario pra transformarEmPedido (Epico 4, orcamento -> pedido)
  // reconstruir a quantidade em METROS internamente (calculo de peso,
  // subtotal bruto pro ERP) sem reconsultar TipoAcondicionamento.tamanhoPadrao
  // do produto - que pode ter mudado entre a criacao do orcamento e a
  // transformacao, e a unidade de venda do item nao pode "flutuar" depois
  // de decidida. Nullable so' pra item sincronizado do Radar (nunca passa
  // por aqui) - ver ProdutoCalculoService/calcularQuantidadePedido pra
  // origem do valor.
  unidade String? @map("unidade")

  // Revisao por item (ver comentario do enum acima) - default PENDENTE pra
  // item sincronizado do ERP e pra item recem-criado localmente, nunca
  // sobrescrito pelo upsert de sync (produto.sync.ts nao referencia esses
  // campos, mesmo criterio ja usado pra precoFabricacao/imagemCaminho em
  // Produto).
  statusAprovacao StatusAprovacaoItemPedido @default(PENDENTE) @map("status_aprovacao")
  decididoPorId   String?                   @map("decidido_por_id")
  decididoEm      DateTime?                 @map("decidido_em")

  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto     Produto? @relation(fields: [produtoId], references: [id])
  decididoPor Usuario? @relation(fields: [decididoPorId], references: [id])

  @@unique([pedidoId, numero])
  @@index([produtoId])
  @@map("pedido_itens")
}

enum TipoNotaFiscal {
  ENTRADA
  SAIDA

  @@map("tipo_nota_fiscal")
}

enum StatusNfe {
  ERRO_VALIDACAO
  AGUARDANDO_AUTORIZACAO
  AUTORIZADA
  DENEGADA
  REJEITADA
  CANCELADA
  INUTILIZADA

  @@map("status_nfe")
}

// Sincronizado do WK Radar (GET /comercial/v1/nota-fiscal) - so leitura, ver
// skill wk-radar-client. Blocos fiscais extensos por item (tributos
// detalhados) e itens[] ficam fora (OS 09) - so mapear se/quando o sistema
// precisar exibir isso, mesmo criterio ja aplicado a produto/pedido.
//
// ATENCAO - esta strategy e estruturalmente diferente das outras (OS 09):
// nota-fiscal so tem DataEmissaoInicial/Final (data de EMISSAO, nao de
// ALTERACAO) - nao ha como pedir "o que mudou desde X" (ver skill
// wk-radar-client, secao "Nota Fiscal"). Por isso NotaFiscalSyncStrategy
// IGNORA o cursor incremental (SyncEntity.ultimaSincronizacao) que as
// outras strategies usam, e sempre reprocessa os ultimos 60 dias inteiros
// a cada execucao (uma vez por dia, de madrugada - ver SyncScheduler). Isso
// e uma troca deliberada: uma nota que mudar (ex: cancelamento) depois
// desses 60 dias nao e capturada - decisao aceita, nao um bug.
model NotaFiscal {
  id                   String          @id @default(uuid())
  idExternoErp         String          @unique @map("id_externo_erp")
  codigoIntegrador     String?         @map("codigo_integrador")
  // Chave de acesso da NF-e/NFS-e - idempotencia adicional, alem do
  // id_externo_erp (ver criterios de aceite da OS 09).
  chave                String?         @unique
  tipo                 TipoNotaFiscal?
  numero               Int?
  serie                String?
  dataEmissao          DateTime?       @map("data_emissao")
  statusNfe            StatusNfe?      @map("status_nfe")
  nfseGerada           Boolean?        @map("nfse_gerada")
  nfseCancelada        Boolean?        @map("nfse_cancelada")
  valorTotalNotaFiscal Decimal?        @map("valor_total_nota_fiscal") @db.Decimal(18, 6)
  sincronizadoEm       DateTime        @map("sincronizado_em")

  pedidos NotaFiscalPedido[]

  @@map("notas_fiscais")
}

// Tabela de ligacao N:N entre nota fiscal e pedido - uma nota pode
// referenciar mais de um pedido (campo `pedidos[]` do WK Radar). Sem dados
// proprios alem das duas FKs, so a associacao em si.
model NotaFiscalPedido {
  notaFiscalId String @map("nota_fiscal_id")
  pedidoId     String @map("pedido_id")

  notaFiscal NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  pedido     Pedido     @relation(fields: [pedidoId], references: [id])

  @@id([notaFiscalId, pedidoId])
  @@index([pedidoId])
  @@map("nota_fiscal_pedidos")
}

// Sincronizado do Estoque.svc (SOAP/WCF, operacao BuscarSaldoProduto) - so
// Estoque Proprio (EP), sem quebra por local de estocagem/filial (decisao
// de escopo desta OS, item "fora de escopo" com o gestor). Chave de upsert
// e codigoProduto (nao ha id proprio no retorno do servico) - casado por
// VALOR contra Produto.codigo, igual a logica que EstoqueService ja usava
// pra resolver identificador antes desta OS (nao e FK: Estoque.svc pode
// retornar um codigo sem produto sincronizado ainda, e nao deve bloquear a
// gravacao do saldo por isso).
model SaldoEstoque {
  id                   String   @id @default(uuid())
  codigoProduto        String   @unique @map("codigo_produto")
  quantidadeDisponivel Decimal  @map("quantidade_disponivel") @db.Decimal(18, 6)
  atualizadoEm         DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("saldos_estoque")
}

// Lotes por local de estocagem (WK BI/Executivo.svc, relatorio "Saldo de
// Produtos por Local de Estocagem" - ver skill wk-radar-bi-client e
// EstoqueLoteSyncStrategy) - metrica DIFERENTE de SaldoEstoque acima
// (fisico bruto somado dos lotes, sem considerar pedido comprometido/
// reservado - as duas NUNCA devem ser somadas nem confundidas, confirmado
// via teste real que nao batem por design).
model EstoqueLote {
  id             String    @id @default(uuid())
  codigoProduto  String    @map("codigo_produto")
  // "" (nunca null) quando o produto nao tem controle de lote (ex: tinta/
  // embalagem, ~1,5% das linhas do catalogo real) - deliberado: NULL nao
  // colide num unique composto no Postgres (cada linha NULL e' unica),
  // o que quebraria o upsert do full refresh (cada sync criaria uma linha
  // nova em vez de atualizar a existente).
  lote           String    @default("")
  localCodigo    String    @map("local_codigo")
  localNome      String    @map("local_nome")
  quantidade     Decimal   @db.Decimal(18, 6)
  fabricadoEm    DateTime? @map("fabricado_em")
  // Momento da sincronizacao que gravou/atualizou esta linha - por linha,
  // nao por execucao (upsert individual, ver EstoqueLoteSyncStrategy).
  sincronizadoEm DateTime  @default(now()) @updatedAt @map("sincronizado_em")

  @@unique([codigoProduto, lote, localCodigo])
  @@map("estoque_lotes")
}

enum TipoCadenciaSync {
  INCREMENTAL
  INCREMENTAL_NOTURNO
  JANELA_FIXA_DIARIA
  CONFIGURAVEL

  @@map("tipo_cadencia_sync")
}

// Config editavel em runtime pra QUALQUER entidade sincronizada (OS
// BACKEND-15 - generaliza o que a OS anterior criou so pra saldo_estoque,
// ver SyncConfigService/AdminSyncController). 1 linha por nomeEntidade -
// entidade sem linha aqui cai no fallback fixo (@Cron de SyncScheduler,
// ver sync.scheduler.ts). tipoCadencia decide quais dos outros campos sao
// usados (intervaloMinutos para INCREMENTAL/CONFIGURAVEL, horarioFixo/
// diasSemana para INCREMENTAL_NOTURNO/JANELA_FIXA_DIARIA) - ver
// construir-repeat-options.ts pra conversao pro formato do BullMQ.
model ConfiguracaoSync {
  id                        String           @id @default(uuid())
  nomeEntidade              String           @unique @map("nome_entidade")
  tipoCadencia              TipoCadenciaSync @map("tipo_cadencia")
  intervaloMinutos          Int?             @map("intervalo_minutos")
  // Formato "HH:mm".
  horarioFixo               String?          @map("horario_fixo")
  // 0=domingo..6=sabado; vazio = todos os dias.
  diasSemana                Int[]            @map("dias_semana")
  // Tamanho da janela retroativa reprocessada a cada execucao, em DIAS
  // (OS-BACKEND-38) - campo distinto de cadencia (com que frequencia roda),
  // este e' QUANTO PASSADO cada execucao reprocessa. So faz sentido pra
  // entidades sem cursor incremental de alteracao (hoje so nota-fiscal, ver
  // NotaFiscalSyncStrategy) - null = usa o padrao hardcoded da propria
  // strategy (60 dias pra nota-fiscal). Nao e' generico o suficiente pra
  // toda entidade (cliente/produto/pedido tem cursor incremental de
  // verdade, esse conceito nao se aplica a eles), mas fica no mesmo lugar
  // de config generalizada em vez de uma tabela so pra nota-fiscal.
  janelaReprocessamentoDias Int?             @map("janela_reprocessamento_dias")
  atualizadoEm              DateTime         @updatedAt @map("atualizado_em")

  @@map("configuracao_sync")
}

// Identidade local minima (OS-BACKEND-19) - ate aqui o backend so conhecia
// o usuario via claims do JWT do IdP (sub/email/name, ver @CurrentUser()),
// sem tabela propria. DispositivoUsuario/ProdutoFavorito precisam de FK de
// verdade, nao de uma string solta - upsert por `sub` na primeira vez que
// o usuario bate num endpoint desta OS (ver UsuariosService).
model Usuario {
  id           String   @id @default(uuid())
  sub          String   @unique
  email        String
  nome         String
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  dispositivos              DispositivoUsuario[]
  favoritos                 ProdutoFavorito[]
  vendedores                Vendedor[]
  localizacoes              LocalizacaoUsuario[]
  acoesFilaProcessadas      AcaoFilaProcessada[]
  historicoStatusPedidos    PedidoHistoricoStatus[]
  documentosEnviados        Documento[]
  agendamentosVisitaCriados AgendamentoVisita[]
  itensPedidoDecididos      PedidoItem[]
  notificacoes              NotificacaoUsuario[]
  mensagensEnviadas         MensagemNotificacao[]
  mensagemPeriodicas        MensagemPeriodica[]

  @@map("usuarios")
}

enum PlataformaDispositivo {
  ANDROID
  IOS
  WEB

  @@map("plataforma_dispositivo")
}

// Token de push (FCM) - chave de upsert e' o token em si (nao
// usuarioId+plataforma), porque cada instalacao do app/aparelho tem um
// token proprio e distinto; um mesmo usuario pode ter varios (celular +
// tablet).
model DispositivoUsuario {
  id           String                @id @default(uuid())
  usuarioId    String                @map("usuario_id")
  token        String                @unique
  plataforma   PlataformaDispositivo
  atualizadoEm DateTime              @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("dispositivos_usuario")
}

// Pre-requisito minimo pro alerta de "produto reabastecido" fazer sentido
// (ver SaldoEstoqueSyncStrategy/NotificacaoDispatchService) - sem isso nao
// haveria como saber quem quer ser avisado sobre qual produto.
model ProdutoFavorito {
  usuarioId String   @map("usuario_id")
  produtoId String   @map("produto_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, produtoId])
  @@map("produtos_favoritos")
}

enum TipoEventoNotificacao {
  PEDIDO_SITUACAO_ALTERADA
  NOTA_FISCAL_REJEITADA
  PRODUTO_REABASTECIDO
  // Extensao pos-OS-BACKEND-28 - vendedor cancelou um check-in de visita,
  // avisa o supervisor DIRETO (nao broadcast, ver
  // NotificacaoDispatchService.resolverTokensAlvo).
  VISITA_CANCELADA
  // Extensao pos-OS-BACKEND-22 (OS-MOBILE-26) - fecha o ciclo de aprovacao
  // de desconto com notificacao direta (nao broadcast, mesmo criterio de
  // VISITA_CANCELADA): CRIADA avisa o aprovador esperado (supervisor/
  // gerente), DECIDIDA avisa de volta o vendedor solicitante.
  SOLICITACAO_DESCONTO_CRIADA
  SOLICITACAO_DESCONTO_DECIDIDA
  // Pedido do usuario (2026-09-29) - job diario (RelatorioDiarioNotificacaoService,
  // dias uteis, ver notificacoes/relatorio-diario-notificacao.scheduler.ts),
  // direto ao proprio vendedor (referenciaId = Vendedor.id, nunca
  // broadcast, mesmo criterio de VISITA_CANCELADA/SOLICITACAO_DESCONTO_*).
  // MANHA = resumo do que precisa de acao pra comecar o dia; FIM_DIA =
  // balanco do que aconteceu. Tipos separados (nao um so com "momento" em
  // `dados`) pra filtro/historico ficar explicito sem precisar abrir o
  // JSON de cada evento.
  RELATORIO_MANHA_PEDIDOS
  RELATORIO_FIM_DIA_PEDIDOS
  // Mensagem manual enviada pelo admin pelo painel web (tela de
  // Notificacoes) - referenciaId = MensagemNotificacao.id. Destinatarios
  // ja resolvidos NO ENVIO (um NotificacaoUsuario por usuario), entao nem
  // o inbox nem o push precisam re-resolver "Todos"/grupo depois - quem
  // entrar num grupo apos o envio nao recebe retroativamente.
  MENSAGEM_DIRETA

  @@map("tipo_evento_notificacao")
}

enum StatusEventoNotificacao {
  PENDENTE
  ENVIADO
  ERRO

  @@map("status_evento_notificacao")
}

// Gravado pelas strategies de sync (pedido/nota-fiscal/saldo-estoque) ao
// detectar uma mudanca relevante (comparacao explicita com o valor
// anterior, dentro da mesma transacao do upsert - ver
// EventoNotificacaoService). Processado depois, de forma assincrona, por
// NotificacaoDispatchService (fila propria, separada da fila de sync, pra
// nao atrasar o cursor incremental).
model EventoNotificacao {
  id           String                  @id @default(uuid())
  tipo         TipoEventoNotificacao
  // id LOCAL (nao idExternoErp) do Pedido/NotaFiscal/Produto conforme o
  // tipo - quem le decide como interpretar, nao ha FK polimorfica no Prisma.
  referenciaId String                  @map("referencia_id")
  titulo       String
  corpo        String
  // Dados extra pro deep-link do app (ex: {"pedidoId": "..."}).
  dados        Json?
  status       StatusEventoNotificacao @default(PENDENTE)
  criadoEm     DateTime                @default(now()) @map("criado_em")
  processadoEm DateTime?               @map("processado_em")
  erro         Json?

  destinatarios NotificacaoUsuario[]

  @@index([status])
  @@map("eventos_notificacao")
}

// Epico 5 - "inbox" web/in-app por usuario, distinto do disparo de push em
// si (EventoNotificacao/NotificacaoDispatchService, que so registra
// ENVIADO/ERRO do lado do FCM, sem saber QUEM leu ou nao). Uma linha por
// (usuario, evento) - criada dentro da MESMA transacao que grava o
// EventoNotificacao (ver registrarEventoNotificacao, evento-notificacao.service.ts),
// resolvendo o destinatario com a MESMA regra de tipo->publico-alvo ja
// usada por NotificacaoDispatchService.resolverTokensAlvo (duplicada
// deliberadamente em resolverUsuariosAlvo, no mesmo arquivo - ver
// comentario la sobre manter as duas em sincronia se um tipo novo entrar).
// Aparece na tela web IMEDIATAMENTE (nao espera o cron de push, que e'
// best-effort e pode falhar/atrasar sem que isso afete o inbox).
model NotificacaoUsuario {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  eventoId  String    @map("evento_id")
  lida      Boolean   @default(false)
  lidaEm    DateTime? @map("lida_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  usuario Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento  EventoNotificacao @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, eventoId])
  @@index([usuarioId, lida, criadoEm])
  @@map("notificacoes_usuario")
}

// Tabela singleton (1 linha, service garante) - config do provedor de LLM
// (OS-BACKEND-20), aba "LLM" da tela de Configuracoes (2026-09-24,
// unificada com as outras 3 abas - antes vivia em /admin/llm sozinha).
// DESVIO DELIBERADO do padrao "credencial de servico externo = env var"
// usado no resto do projeto (WK_RADAR_*/WK_BI_*/FIREBASE_SERVICE_ACCOUNT_JSON)
// - pedido explicito do usuario ("deixe uma opcao de configuracao"), nao
// trocar por env var sem re-confirmar. A(s) chave(s) em si NAO ficam mais
// aqui (ver ChaveLlm abaixo, 2026-09-24: suporte a multiplas chaves com
// fallback em cadeia) - esta tabela so guarda provedor/modelo, compartilhado
// entre todas as chaves. Endpoint protegido por requireRole('admin') (ver
// configuracoes.module.ts), mesmo criterio das outras 3 abas.
model ConfiguracaoLlm {
  id            String   @id @default(uuid())
  // "openrouter" por enquanto (gateway OpenAI-compatible cobrindo
  // Claude/GPT/etc via o campo `modelo`) - string livre, nao enum, pra
  // nao exigir migration se um provedor novo entrar depois.
  provedor      String   @default("openrouter")
  modelo        String   @default("anthropic/claude-opus-5")
  // Pedido explicito do usuario (2026-09-25) - liga/desliga o fallback em
  // cadeia entre chaves (ver ChaveLlm). Default LIGADO (mesmo
  // comportamento de sempre desde 2026-09-24). Desligado,
  // LlmClientService.gerarJson tenta SO a primeira chave ativa (menor
  // `ordem`) e propaga o erro direto se ela falhar, sem cair pra proxima.
  fallbackAtivo Boolean  @default(true) @map("fallback_ativo")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_llm")
}

// Multiplas chaves de API de LLM com fallback em cadeia (2026-09-24, pedido
// explicito do usuario: "lista de fallback, caso uma chave nao responda,
// cai pra proxima") - LlmClientService.gerarJson tenta as `ativa: true` em
// ordem crescente de `ordem` (drag-and-drop na tela reordena), parando na
// primeira que responder com sucesso. `ordem` nao e' unico por design (a
// tela reescreve o bloco inteiro a cada reordenacao, sem gap/compactacao
// necessaria). apiKey cifrada em runtime (AES-256-GCM, ver
// SegredoCryptoService) antes de gravar, mesmo criterio que a antiga
// ConfiguracaoLlm.apiKey (removida) - nunca texto plano no Postgres, nunca
// retornada em GET (so um preview mascarado, ver ChaveLlmService).
model ChaveLlm {
  id           String   @id @default(uuid())
  rotulo       String
  apiKey       String   @map("api_key")
  ordem        Int      @default(0)
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([ativa, ordem])
  @@map("chaves_llm")
}

// Sincronizado do WK Radar (GET /empresarial/v1/vendedor) - so leitura, ver
// skill wk-radar-client. DIFERENTE de cliente/produto/pedido: o endpoint nao
// tem NENHUM filtro de data (nem cursor unico, nem par Inicial/Final -
// confirmado contra o swagger.json do ambiente de testes), entao nao ha
// sync incremental de verdade - VendedorSyncStrategy reprocessa a lista
// inteira a cada execucao (agendamento JANELA_FIXA_DIARIA, mesmo padrao de
// NotaFiscal, ver vendedor.sync.ts).
//
// Vinculo com Usuario (OS-BACKEND-21): usuarioId e' resolvido no upsert por
// correspondencia de e-mail (Vendedor.email x Usuario.email,
// case-insensitive) - NAO e' uma FK vinda do WK Radar, e' calculada aqui.
// Usuario so existe apos o primeiro login desse vendedor no app (ver
// UsuariosService.obterOuCriarPorSub), entao a maioria dos vendedores pode
// nao ter correspondencia na primeira sincronizacao - normal, reavaliado a
// cada full refresh noturno. semCorrespondenciaUsuario sinaliza esse caso
// explicitamente (mesmo padrao de Produto.incompleto/Cliente.incompleto
// pra flag de estado) em vez de so depender de usuarioId ser null, que
// tambem seria o estado antes de qualquer tentativa de vinculo.
model Vendedor {
  id                        String   @id @default(uuid())
  idExternoErp              String   @unique @map("id_externo_erp")
  codigoIntegrador          String?  @map("codigo_integrador")
  codigo                    String?
  nome                      String?
  email                     String?
  // NAO vem do WK Radar (endpoint /vendedor nao tem telefone/whatsapp) -
  // cadastrado manualmente pelo admin (PATCH /admin/vendedores/:id,
  // 2026-09-28), pro PDF de impressao do pedido (bloco "Vendedor(a)").
  whatsapp                  String?
  inativo                   Boolean  @default(false)
  usuarioId                 String?  @map("usuario_id")
  semCorrespondenciaUsuario Boolean  @default(true) @map("sem_correspondencia_usuario")
  sincronizadoEm            DateTime @map("sincronizado_em")

  // Hierarquia (OS-BACKEND-22) - NAO vem do WK Radar (endpoint /vendedor nao
  // tem esses campos, ver skill wk-radar-client), configurada manualmente
  // pelo admin via PATCH /admin/vendedores/:id/hierarquia. papel default
  // VENDEDOR (nivel mais baixo) ate' alguem configurar diferente - nunca
  // fica sem valor, so sem hierarquia (supervisorId null) ate' ser setada.
  papel        PapelVendedor @default(VENDEDOR)
  supervisorId String?       @map("supervisor_id")
  supervisor   Vendedor?     @relation("HierarquiaVendedor", fields: [supervisorId], references: [id])
  subordinados Vendedor[]    @relation("HierarquiaVendedor")

  // true quando esta linha foi criada como stub por ClienteSyncStrategy
  // (OS-BACKEND-23, detalhes.idVendedores referenciando um vendedor ainda
  // nao sincronizado) - mesmo padrao de Produto/Cliente/Pedido.incompleto
  // (OS 06/07). VendedorSyncStrategy sempre grava false ao completar os
  // dados de verdade no proximo full refresh.
  incompleto Boolean @default(false)

  // OS-novas-implementacoes.md Bloco 5 - "permitir check-in sem
  // agendamento". Default TRUE (nao false) de proposito: preserva o
  // comportamento ATUAL do sistema (check-in sempre funcionou sem
  // conceito de agendamento) pra todo vendedor ja existente - exigir
  // agendamento e' uma restricao NOVA que o admin liga explicitamente por
  // vendedor, nunca fica ligada por omissao.
  permiteCheckinSemAgendamento Boolean @default(true) @map("permite_checkin_sem_agendamento")

  // Horario de trabalho individual (Epico 4, config-aba-rastreio.jpg -
  // "Desabilitar edição de horário de trabalho no Android") - null =
  // sem customizacao, o app usa o horario GLOBAL de
  // ConfiguracaoRastreio.horarioInicio/TerminoRastreamento como fallback.
  // So editavel pelo proprio vendedor via PATCH /vendedores/me/horario-
  // trabalho QUANDO ConfiguracaoRastreio.desabilitarEdicaoHorarioTrabalhoAndroid
  // for false (ver VendedoresService) - "HH:mm", mesmo formato da config
  // global.
  horarioInicioTrabalho String? @map("horario_inicio_trabalho") @db.VarChar(5)
  horarioFimTrabalho    String? @map("horario_fim_trabalho") @db.VarChar(5)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  clientes ClienteVendedor[]

  solicitacoesSolicitadas     SolicitacaoDesconto[] @relation("SolicitacaoVendedorSolicitante")
  solicitacoesParaAprovar     SolicitacaoDesconto[] @relation("SolicitacaoAprovadorEsperado")
  solicitacoesDecididas       SolicitacaoDesconto[] @relation("SolicitacaoAprovador")
  pedidosCriados              Pedido[]
  pedidosComoVendedorRadar    Pedido[]              @relation("PedidoVendedorRadar")
  visitas                     Visita[]
  clientesLocalizacaoDefinida Cliente[]             @relation("ClienteLocalizacaoDefinidaPor")
  metas                       MetaVendedor[]
  coberturasComoOriginal      CoberturaTemporaria[] @relation("CoberturaVendedorOriginal")
  coberturasComoSubstituto    CoberturaTemporaria[] @relation("CoberturaVendedorSubstituto")
  agendamentosVisita          AgendamentoVisita[]
  gruposMensagem              GrupoMensagemMembro[]
  mensagensRecebidas          MensagemNotificacao[]
  mensagensPeriodicas         MensagemPeriodica[]

  @@map("vendedores")
}

// Agendamento previo de visita (OS-novas-implementacoes.md Bloco 5) -
// feature NOVA (nao existia nenhum conceito de agendamento antes) -
// decisao confirmada com o usuario: construir do zero, junto com a
// excecao de check-in sem agendamento (Vendedor.permiteCheckinSemAgendamento
// acima). VisitasService.checkin() exige um agendamento pra HOJE
// (clienteId+vendedorId+dataHoraPrevista no dia do check-in) quando a
// flag do vendedor estiver desligada - ver criterio de aceite.
model AgendamentoVisita {
  id               String   @id @default(uuid())
  clienteId        String   @map("cliente_id")
  vendedorId       String   @map("vendedor_id")
  dataHoraPrevista DateTime @map("data_hora_prevista")
  criadoPorId      String   @map("criado_por_id")
  criadoEm         DateTime @default(now()) @map("criado_em")

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedor  Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  criadoPor Usuario  @relation(fields: [criadoPorId], references: [id])

  @@index([vendedorId, dataHoraPrevista])
  @@index([clienteId])
  @@map("agendamentos_visita")
}

enum PapelVendedor {
  VENDEDOR
  SUPERVISOR
  GERENTE

  @@map("papel_vendedor")
}

// Meta por vendedor (OS-BACKEND-44) - configurada manualmente pelo
// admin/supervisor (nao vem do Radar, mesmo motivo estrutural de
// Vendedor.papel/supervisorId acima: e' decisao de gestao interna, sem
// endpoint equivalente no ERP). `periodo` como string (nao DateTime) -
// representa um MES ("YYYY-MM") ou uma SEMANA ISO ("YYYY-Www", segunda a
// domingo) inteiros, nao um instante; evita ambiguidade de fuso horario na
// comparacao "qual periodo e' esse timestamp" que um DateTime exigiria a
// cada leitura. O FORMATO de `periodo` depende de `periodicidade`.
//
// Pedido do usuario (2026-09-28):
// 1. Mensal e semanal podem coexistir (um vendedor pode ter as duas metas
//    ativas ao mesmo tempo, mostradas separadas) - por isso periodicidade
//    entra na chave unica, nao e' so um filtro.
// 2. Só um TIPO de meta ativo por periodo (Dinheiro OU Peso OU Margem,
//    nunca mais de um simultaneo pro mesmo vendedor+periodicidade+periodo)
//    - tipoMeta fica FORA da chave unica de proposito: trocar o tipo e'
//    um update no mesmo registro, nao um novo.
// 3. Margem ainda nao tem calculo de progresso implementado (so o nome
//    existe como opcao selecionavel) - ver MetaVendedorService.obterProgresso.
model MetaVendedor {
  id            String                @id @default(uuid())
  vendedorId    String                @map("vendedor_id")
  periodicidade TipoPeriodicidadeMeta @default(MENSAL)
  periodo       String
  tipoMeta      TipoMeta              @default(DINHEIRO) @map("tipo_meta")
  valorMeta     Decimal               @map("valor_meta") @db.Decimal(18, 6)
  criadoEm      DateTime              @default(now()) @map("criado_em")
  atualizadoEm  DateTime              @updatedAt @map("atualizado_em")

  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@unique([vendedorId, periodicidade, periodo])
  @@map("metas_vendedor")
}

enum TipoPeriodicidadeMeta {
  MENSAL
  SEMANAL
}

// PESO usa Pedido.pesoLiquidoTotalKg (meta em Kg) - MARGEM ainda sem
// calculo de progresso (so o nome existe como opcao, ver comentario acima
// em MetaVendedor).
enum TipoMeta {
  DINHEIRO
  PESO
  MARGEM
}

// Substituicao temporaria de carteira (OS-BACKEND-48) - enquanto ativa
// (dataInicio <= agora <= dataFim), o escopo de clientes do substituto
// (VendedorEscopoService) passa a incluir tambem a carteira do original,
// alem da propria. Configurada manualmente (admin), nao vem do Radar -
// mesmo motivo estrutural de Vendedor.papel/supervisorId. Fim automatico
// e' so' a passagem de dataFim - nenhum job precisa "desligar" nada, o
// escopo so consulta coberturas com a data ainda dentro da janela.
model CoberturaTemporaria {
  id                   String   @id @default(uuid())
  vendedorOriginalId   String   @map("vendedor_original_id")
  vendedorSubstitutoId String   @map("vendedor_substituto_id")
  dataInicio           DateTime @map("data_inicio")
  dataFim              DateTime @map("data_fim")
  criadoEm             DateTime @default(now()) @map("criado_em")

  vendedorOriginal   Vendedor @relation("CoberturaVendedorOriginal", fields: [vendedorOriginalId], references: [id], onDelete: Cascade)
  vendedorSubstituto Vendedor @relation("CoberturaVendedorSubstituto", fields: [vendedorSubstitutoId], references: [id], onDelete: Cascade)

  @@index([vendedorSubstitutoId, dataInicio, dataFim])
  @@map("coberturas_temporarias")
}

// Singleton (1 linha, mesmo padrao de ConfiguracaoDesconto/ConfiguracaoLlm)
// - flag de visibilidade do ranking de equipe (OS-BACKEND-44): decisao do
// supervisor/gerente se o VENDEDOR comum enxerga o ranking da propria
// equipe ou so a supervisao. false por padrao (fail-closed - nao expor
// comparativo entre colegas ate' alguem decidir habilitar).
model ConfiguracaoGamificacao {
  id                         String   @id @default(uuid())
  rankingVisivelParaVendedor Boolean  @default(false) @map("ranking_visivel_para_vendedor")
  atualizadoEm               DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_gamificacao")
}

// Tabela singleton (1 linha, service garante) - limite de desconto que
// dispara aprovacao (OS-BACKEND-22). DESVIO DELIBERADO do padrao
// "credencial de servico externo = env var": aqui e' regra de negocio, nao
// credencial, e o proprio texto da OS pede "para poder ajustar sem
// deploy" - por isso fica em tabela (mesmo padrao estrutural de
// ConfiguracaoLlm), editavel via PATCH /admin/configuracao-desconto, nao
// env var. limitePercentual continua o UNICO valor que a hierarquia de
// aprovacao (SolicitacaoDesconto, ver domain/solicitacao-desconto.entity.ts)
// realmente usa pra decidir se dispara aprovacao - e' o que a aba
// "Alcada de Aprovacao" da tela de Configuracoes (Epico 4,
// OS-dashboard-configuracoes-notificacoes-auditoria.md) rotula como
// "Percentual maximo de desconto para vendedores". habilitarAprovacaoPorAlcada/
// percentualAlcadaGerencial/percentualAlcadaSupervisao sao os 3 campos
// adicionais dessa aba (referencia: config-aba-aprovacao.jpg) - guardados
// aqui pra edicao futura ja ficarem disponiveis via GET/PATCH, mas AINDA
// NAO conectados a logica de aprovacao (SolicitacaoDesconto.necessitaAprovacao/
// calcularPapelExigido continuam usando so' limitePercentual + hierarquia de
// papel fixa) - wire-up registrado como pendencia em
// OS-pendentes-claude-code.md, fora do escopo desta OS (que pede so' a
// tela de configuracao, nao mudanca na regra de aprovacao em si).
model ConfiguracaoDesconto {
  id                          String   @id @default(uuid())
  limitePercentual            Decimal  @default(20) @map("limite_percentual") @db.Decimal(5, 2)
  habilitarAprovacaoPorAlcada Boolean  @default(true) @map("habilitar_aprovacao_por_alcada")
  percentualAlcadaGerencial   Decimal  @default(50) @map("percentual_alcada_gerencial") @db.Decimal(5, 2)
  percentualAlcadaSupervisao  Decimal  @default(50) @map("percentual_alcada_supervisao") @db.Decimal(5, 2)
  atualizadoEm                DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_desconto")
}

// Tabela singleton (1 linha, service garante) - aba "Orcamento" da tela de
// Configuracoes (Epico 4, OS-dashboard-configuracoes-notificacoes-auditoria.md).
// Referencia: config-aba-orcamento.jpg. "Orcamento" como conceito de negocio
// distinto de Pedido ainda nao existe no modelo de dados (ver
// OS-pendentes-claude-code.md) - estas 4 flags sao apenas as configuracoes
// que a tela pede pra existir, sem ainda ligar a nenhum fluxo real de
// orcamento (fora do escopo desta OS).
model ConfiguracaoOrcamento {
  id                                       String   @id @default(uuid())
  habilitarCriacaoOrcamento                Boolean  @default(true) @map("habilitar_criacao_orcamento")
  permitirVendedorTransformarEmPedido      Boolean  @default(true) @map("permitir_vendedor_transformar_em_pedido")
  criarPedidoSugeridoComoOrcamento         Boolean  @default(true) @map("criar_pedido_sugerido_como_orcamento")
  permitirAlteracaoVendedorOrcamentoCriado Boolean  @default(true) @map("permitir_alteracao_vendedor_orcamento_criado")
  // Pedido explicito do usuario (2026-09-24) - por padrao BLOQUEADO (mesmo
  // comportamento de sempre, sem mudanca nenhuma pra quem nao mexer na
  // config). Ligado, CriarPedidoService.validarItensSemDuplicata deixa de
  // rejeitar o mesmo produtoId duas vezes no mesmo pedido.
