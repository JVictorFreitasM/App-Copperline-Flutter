generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SyncLogStatus {
  EM_ANDAMENTO
  SUCESSO
  ERRO

  @@map("sync_log_status")
}

model SyncEntity {
  id                  String    @id @default(uuid())
  nome                String    @unique
  ativo               Boolean   @default(true)
  // Inicio da janela [ultimaSincronizacao, agora] da proxima execucao -
  // gravado pelo SyncService so quando a busca no ERP (strategy.fetch)
  // completa sem erro, mesmo que registros individuais tenham falhado
  // depois (ver SyncService.executar).
  ultimaSincronizacao DateTime? @map("ultima_sincronizacao")
  criadoEm            DateTime  @default(now()) @map("criado_em")
  atualizadoEm        DateTime  @updatedAt @map("atualizado_em")

  logs SyncLog[]

  @@map("sync_entities")
}

model SyncLog {
  id                   String        @id @default(uuid())
  syncEntityId         String        @map("sync_entity_id")
  status               SyncLogStatus @default(EM_ANDAMENTO)
  iniciadoEm           DateTime      @default(now()) @map("iniciado_em")
  finalizadoEm         DateTime?     @map("finalizado_em")
  registrosProcessados Int           @default(0) @map("registros_processados")
  registrosComErro     Int           @default(0) @map("registros_com_erro")
  erro                 Json?
  // Avisos nao-fatais (ex: suspeita de truncamento silencioso numa
  // sub-janela de paginacao - ver skill wk-radar-client, secao
  // "Paginacao"). Lista de strings; null quando nao ha nenhum.
  avisos               Json?

  syncEntity SyncEntity @relation(fields: [syncEntityId], references: [id])

  @@index([syncEntityId])
  @@map("sync_logs")
}

// Sincronizado do WK Radar (GET /empresarial/v1/cliente) - so leitura, ver
// skill wk-radar-client. codigoIntegrador existe desde ja para quando
// houver escrita de volta no ERP (fora de escopo nesta OS).
model Cliente {
  id               String   @id @default(uuid())
  idExternoErp     String   @unique @map("id_externo_erp")
  codigoIntegrador String?  @map("codigo_integrador")
  cpfCnpj          String?  @map("cpf_cnpj")
  razaoSocial      String?  @map("razao_social")
  nomeFantasia     String?  @map("nome_fantasia")
  inativo          Boolean  @default(false)
  // Enderecos nao tem id/codigoIntegrador proprio no WK Radar (ao contrario
  // de contatos) - sem identidade propria pra preservar, JSONB e suficiente.
  enderecos        Json     @default("[]")
  // true quando esta linha foi criada como stub por PedidoSyncStrategy (OS
  // 07, pedido referenciando um cliente ainda nao sincronizado) - clienteSync
  // sempre grava false ao completar os dados de verdade, seja criando ou
  // atualizando.
  incompleto       Boolean  @default(false)
  sincronizadoEm   DateTime @map("sincronizado_em")

  // Dados financeiros embutidos no proprio cadastro do cliente no WK Radar
  // (informacoesFinanceiras) - vem junto do sync normal, sem chamada extra
  // (OS-BACKEND-36). O DTO do Radar tambem tem descontoFinanceiro/desconto,
  // mas so limiteCredito foi pedido pela OS - os demais ficam fora de
  // escopo. Inadimplencia/notas em aberto NAO vem daqui: sao consultadas
  // sob demanda em /api/financeiro/v1/titulo-contas-receber (ver
  // ClienteFinanceiroService) - endpoint separado, sem persistir localmente
  // (dado transacional que muda com cada pagamento).
  limiteCredito     Decimal?  @map("limite_credito") @db.Decimal(14, 2)
  dataLimiteCredito DateTime? @map("data_limite_credito")

  // "Pin" de localizacao (visita com foto/geolocalizacao, extensao da
  // OS-BACKEND-28) - NAO vem do WK Radar (o endereco em `enderecos` acima
  // e' o cadastral, sem coordenada). Definido manualmente por um vendedor
  // vinculado ao cliente via PATCH /clientes/:id/localizacao, uma vez
  // (redefinivel depois). Serve de referencia pra validar que check-in e
  // checkout de visita aconteceram a ate 50m de distancia (ver
  // VisitasService, domain/distancia-geografica.ts) - sem pin definido,
  // check-in fica bloqueado (nao ha o que validar contra).
  localizacaoLat           Decimal?  @map("localizacao_lat") @db.Decimal(9, 6)
  localizacaoLng           Decimal?  @map("localizacao_lng") @db.Decimal(9, 6)
  localizacaoDefinidaEm    DateTime? @map("localizacao_definida_em")
  localizacaoDefinidaPorId String?   @map("localizacao_definida_por_id")

  contatos               ContatoCliente[]
  pedidos                Pedido[]
  vendedores             ClienteVendedor[]
  visitas                Visita[]
  localizacaoDefinidaPor Vendedor?         @relation("ClienteLocalizacaoDefinidaPor", fields: [localizacaoDefinidaPorId], references: [id])

  @@map("clientes")
}

// N:N (OS-BACKEND-23) - o WK Radar modela vinculo de cliente com vendedor
// como detalhes.idVendedores, um ARRAY (confirmado contra o swagger.json
// do ambiente de testes) - um cliente pode ter mais de um vendedor
// vinculado (raro na pratica, mas possivel - decisao confirmada com o
// usuario). Por isso NAO e' um campo unico vendedorResponsavelId em
// Cliente como o texto original da OS sugeria, e sim esta tabela de
// vinculo, recriada do zero a cada sync (delete+recreate por clienteId -
// mesmo padrao ja usado em NotaFiscalPedido, ver nota-fiscal.sync.ts) em
// vez de tentar diffar contra o estado anterior.
model ClienteVendedor {
  id         String   @id @default(uuid())
  clienteId  String   @map("cliente_id")
  vendedorId String   @map("vendedor_id")
  criadoEm   DateTime @default(now()) @map("criado_em")

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@unique([clienteId, vendedorId])
  @@index([vendedorId])
  @@map("clientes_vendedores")
}

// Contatos tem identidade propria no WK Radar (id + codigoIntegrador
// proprios), por isso viram tabela relacionada em vez de ficarem
// embutidos no JSON do cliente (decisao desta OS, ver README do sync).
model ContatoCliente {
  id               String   @id @default(uuid())
  idExternoErp     String   @unique @map("id_externo_erp")
  codigoIntegrador String?  @map("codigo_integrador")
  clienteId        String   @map("cliente_id")
  nome             String?
  email            String?
  telefoneDdd      String?  @map("telefone_ddd")
  telefoneNumero   String?  @map("telefone_numero")
  funcao           String?
  sincronizadoEm   DateTime @map("sincronizado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("contatos_clientes")
}

enum TipoProduto {
  INVALIDO
  CLASSE
  PROPRIO
  TERCEIROS
  KIT

  @@map("tipo_produto")
}

// Sincronizado do WK Radar (GET /empresarial/v1/produto) - so leitura, ver
// skill wk-radar-client. kit[] e blocos fiscais extensos (ipi,
// aliquotasICMS, produtoPISCOFINS) ficam fora por enquanto (OS 06) - so
// mapear se/quando o sistema precisar exibir isso.
//
// Decisao de grade (OS 06): idGrade1/2/3 (dimensoes, ex: cor/tamanho) e
// referenciasGrade[] (combinacoes especificas) NAO tem id/codigoIntegrador
// proprio no WK Radar - igual a "enderecos" em Cliente, sem identidade
// propria pra preservar. Por isso cada combinacao de grade NAO vira linha
// propria; fica embutida como JSONB no produto base. A chave de upsert
// continua sendo so id_externo_erp (id do produto base no WK Radar), sem
// incluir niveis de grade.
model Produto {
  id               String       @id @default(uuid())
  idExternoErp     String       @unique @map("id_externo_erp")
  codigoIntegrador String?      @map("codigo_integrador")
  codigo           String?
  nome             String?
  descricao        String?
  tipo             TipoProduto?
  inativo          Boolean      @default(false)
  precoVenda       Decimal?     @map("preco_venda") @db.Decimal(18, 6)
  gtin             String?
  idGrade1         String?      @map("id_grade_1")
  idGrade2         String?      @map("id_grade_2")
  idGrade3         String?      @map("id_grade_3")
  referenciasGrade Json         @default("[]") @map("referencias_grade")
  // true quando esta linha foi criada como stub por PedidoSyncStrategy (OS
  // 07, item de pedido referenciando um produto ainda nao sincronizado) -
  // produtoSync sempre grava false ao completar os dados de verdade.
  incompleto       Boolean      @default(false)
  sincronizadoEm   DateTime     @map("sincronizado_em")

  // Comprimento por peca/unidade fechada (OS-BACKEND-24), mapeado de
  // dimensoes.comprimento do WK Radar - so quando
  // dimensoes.unidadeMedidaComprimento e' "Metro" (valor exato do enum
  // ainda NAO confirmado contra o ambiente real - ver comentario em
  // produto.sync.ts); em qualquer outro caso fica null (fail-safe, nunca
  // interpreta um valor errado como metro). Usado por
  // calcularQuantidadePedido pra POC/KM - RET nao depende disso.
  comprimentoMetros Decimal? @map("comprimento_metros") @db.Decimal(10, 3)

  // PENDENCIA (OS-BACKEND-24): origem/regra de classificacao (campo nativo
  // do Radar `classificacao` vs. calculo local a partir de
  // comprimentoMetros, incluindo o corte exato entre 30-50m) NAO foi
  // confirmada com quem define a regra de negocio - decisao explicita de
  // deixar como pendencia por enquanto. Nullable, sem populacao automatica
  // nem endpoint de atribuicao manual ainda - so o campo existe, pronto
  // pra ser preenchido quando a regra for definida.
  tipoVenda TipoVendaProduto? @map("tipo_venda")

  itensPedido PedidoItem[]
  favoritos   ProdutoFavorito[]

  @@map("produtos")
}

enum TipoVendaProduto {
  POC
  RET
  KM

  @@map("tipo_venda_produto")
}

enum TipoSituacaoPedido {
  EM_ANALISE
  BLOQUEADO
  PENDENTE
  CANCELADO
  PARCIALMENTE_FATURADO
  FATURADO
  PARCIALMENTE_ATENDIDO
  ATENDIDO

  @@map("tipo_situacao_pedido")
}

enum SituacaoItemPedido {
  NENHUM
  CANCELADO
  FATURADO
  PARCIALMENTE_FATURADO
  ATENDIDO
  PARCIALMENTE_ATENDIDO
  PENDENTE

  @@map("situacao_item_pedido")
}

// Sincronizado do WK Radar (GET /comercial/v1/pedido) - so leitura, ver
// skill wk-radar-client. Blocos extensos de tributos/rateios/liberacoes de
// estoque por item ficam fora (OS 07) - so mapear se/quando o sistema
// precisar exibir isso, mesmo criterio ja aplicado a produto.
//
// Referencia a cliente (OS 07): idCliente e opcional (nullable) porque um
// pedido pode chegar antes do cliente correspondente ter sido sincronizado
// (ordem de sync nao e garantida entre entidades independentes, so a ordem
// de dependencia LOGICA foi pensada nas OSs - ver dependencias da OS 07).
// Em vez de pular o pedido (o que o perderia permanentemente: o cursor de
// sync avanca mesmo com erro pontual - ver SyncService - entao um pedido
// pulado nunca mais apareceria numa janela futura), PedidoSyncStrategy cria
// um Cliente STUB (incompleto=true) com so o id_externo_erp, satisfazendo a
// FK imediatamente. Quando cliente.sync.ts sincronizar esse cliente de
// verdade (em qualquer execucao futura), o upsert por id_externo_erp
// completa os dados e zera incompleto - sem exigir nenhuma acao retroativa
// no pedido. Mesma logica pra ProdutoSyncStrategy resolvendo produto: em
// PedidoItem.produtoId.
model Pedido {
  id                      String              @id @default(uuid())
  // Nullable (OS-BACKEND-25) - so os pedidos SINCRONIZADOS do ERP tem
  // idExternoErp desde a criacao da linha; um pedido criado LOCALMENTE
  // (POST /pedidos) comeca sem ele (ainda nao existe no Radar) e so ganha
  // valor apos o envio confirmar sucesso. Postgres permite varios NULL
  // numa coluna @unique, entao isso nao quebra a unicidade pros pedidos
  // que ja tem id real.
  idExternoErp            String?             @unique @map("id_externo_erp")
  codigoIntegrador        String?             @map("codigo_integrador")
  numero                  String?
  situacao                TipoSituacaoPedido?
  dataHoraUltimaAlteracao DateTime?           @map("data_hora_ultima_alteracao")
  clienteId               String?             @map("cliente_id")
  valorTotal              Decimal?            @map("valor_total") @db.Decimal(18, 6)
  // true quando esta linha foi criada como stub por NotaFiscalSyncStrategy
  // (OS 09, nota fiscal referenciando um pedido ainda nao sincronizado) -
  // pedidoSync sempre grava false ao completar os dados de verdade. Mesmo
  // padrao ja usado em Cliente/Produto (OS 07). NAO e' o mesmo conceito de
  // um pedido criado localmente (ver vendedorId/statusLocal abaixo) - um
  // pedido local tem dado completo do nosso lado, so ainda nao tem
  // situacao/numero do Radar.
  incompleto              Boolean             @default(false)
  sincronizadoEm          DateTime            @map("sincronizado_em")

  // Origem local (OS-BACKEND-25, POST /pedidos) - null pra pedidos que so
  // existem por sincronizacao (nunca criados pelo nosso sistema).
  // vendedorId e' quem criou; statusLocal controla o gate de aprovacao de
  // desconto (ver CriarPedidoService) - PENDENTE nunca foi enviado ao ERP,
  // ENVIADO ja foi confirmado (idExternoErp preenchido). Sem status
  // "ERRO_ENVIO" de proposito: se o envio falha, a linha inteira e'
  // descartada (nunca persistida) em vez de marcada com erro - ver
  // criterio de aceite "sem deixar registro orfao no banco local".
  vendedorId                   String?            @map("vendedor_id")
  percentualDescontoSolicitado Decimal?           @map("percentual_desconto_solicitado") @db.Decimal(5, 2)
  statusLocal                  StatusPedidoLocal? @map("status_local")

  cliente              Cliente?                @relation(fields: [clienteId], references: [id])
  vendedor             Vendedor?               @relation(fields: [vendedorId], references: [id])
  itens                PedidoItem[]
  notasFiscais         NotaFiscalPedido[]
  solicitacoesDesconto SolicitacaoDesconto[]
  historicoStatus      PedidoHistoricoStatus[]

  @@index([clienteId])
  @@map("pedidos")
}

enum StatusPedidoLocal {
  AGUARDANDO_APROVACAO
  ENVIADO

  @@map("status_pedido_local")
}

// Rastreabilidade de status do pedido (OS-BACKEND-33) - statusAnterior/
// statusNovo sao texto livre (nao um enum unico), de proposito: cobrem
// tanto StatusPedidoLocal (ENVIADO/AGUARDANDO_APROVACAO, na criacao) quanto
// o resultado da decisao de desconto (APROVADO/REJEITADO, ver
// SolicitacoesDescontoService.decidir) - dois vocabularios diferentes sobre
// o mesmo pedido, sem um enum comum que faca sentido pros dois. alteradoPor
// nullable so pro caso (hoje inexistente na pratica) de uma transicao sem
// ator humano identificavel - toda transicao ja implementada tem um
// usuarioId real (quem criou o pedido, quem decidiu a solicitacao).
model PedidoHistoricoStatus {
  id             String   @id @default(uuid())
  pedidoId       String   @map("pedido_id")
  statusAnterior String?  @map("status_anterior")
  statusNovo     String   @map("status_novo")
  alteradoPor    String?  @map("alterado_por")
  alteradoEm     DateTime @default(now()) @map("alterado_em")

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [alteradoPor], references: [id])

  @@index([pedidoId])
  @@map("pedido_historico_status")
}

// Itens de pedido NAO tem id/codigoIntegrador proprio no WK Radar (so
// `numero`, a posicao do item dentro do pedido) - diferente de contatos,
// sem identidade externa pra usar como chave de upsert. A chave de upsert e
// o par (pedidoId, numero).
//
// Referencia a produto (OS 07, ver nota da skill wk-radar-client sobre
// "Sistema de grade"): produtoServico do WK Radar identifica o item pela
// combinacao id + idItemGrade1/2/3, nao so pelo id do produto base. Como a
// OS 06 decidiu nao criar uma linha por combinacao de grade (referenciasGrade
// fica embutido como JSONB em Produto), o FK produtoId aponta pro produto
// BASE (Produto.idExternoErp = produtoServico.id) e idItemGrade1/2/3 ficam
// gravados aqui so como colunas descritivas (qual combinacao foi pedida),
// nao como parte da chave de relacionamento.
model PedidoItem {
  id              String              @id @default(uuid())
  pedidoId        String              @map("pedido_id")
  numero          Int
  produtoId       String?             @map("produto_id")
  idItemGrade1    String?             @map("id_item_grade_1")
  idItemGrade2    String?             @map("id_item_grade_2")
  idItemGrade3    String?             @map("id_item_grade_3")
  quantidadeVenda Decimal?            @map("quantidade_venda") @db.Decimal(18, 6)
  valorUnitario   Decimal?            @map("valor_unitario") @db.Decimal(18, 6)
  valorTotal      Decimal?            @map("valor_total") @db.Decimal(18, 6)
  situacao        SituacaoItemPedido?
  sincronizadoEm  DateTime            @map("sincronizado_em")

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id])

  @@unique([pedidoId, numero])
  @@index([produtoId])
  @@map("pedido_itens")
}

enum TipoNotaFiscal {
  ENTRADA
  SAIDA

  @@map("tipo_nota_fiscal")
}

enum StatusNfe {
  ERRO_VALIDACAO
  AGUARDANDO_AUTORIZACAO
  AUTORIZADA
  DENEGADA
  REJEITADA
  CANCELADA
  INUTILIZADA

  @@map("status_nfe")
}

// Sincronizado do WK Radar (GET /comercial/v1/nota-fiscal) - so leitura, ver
// skill wk-radar-client. Blocos fiscais extensos por item (tributos
// detalhados) e itens[] ficam fora (OS 09) - so mapear se/quando o sistema
// precisar exibir isso, mesmo criterio ja aplicado a produto/pedido.
//
// ATENCAO - esta strategy e estruturalmente diferente das outras (OS 09):
// nota-fiscal so tem DataEmissaoInicial/Final (data de EMISSAO, nao de
// ALTERACAO) - nao ha como pedir "o que mudou desde X" (ver skill
// wk-radar-client, secao "Nota Fiscal"). Por isso NotaFiscalSyncStrategy
// IGNORA o cursor incremental (SyncEntity.ultimaSincronizacao) que as
// outras strategies usam, e sempre reprocessa os ultimos 60 dias inteiros
// a cada execucao (uma vez por dia, de madrugada - ver SyncScheduler). Isso
// e uma troca deliberada: uma nota que mudar (ex: cancelamento) depois
// desses 60 dias nao e capturada - decisao aceita, nao um bug.
model NotaFiscal {
  id                   String          @id @default(uuid())
  idExternoErp         String          @unique @map("id_externo_erp")
  codigoIntegrador     String?         @map("codigo_integrador")
  // Chave de acesso da NF-e/NFS-e - idempotencia adicional, alem do
  // id_externo_erp (ver criterios de aceite da OS 09).
  chave                String?         @unique
  tipo                 TipoNotaFiscal?
  numero               Int?
  serie                String?
  dataEmissao          DateTime?       @map("data_emissao")
  statusNfe            StatusNfe?      @map("status_nfe")
  nfseGerada           Boolean?        @map("nfse_gerada")
  nfseCancelada        Boolean?        @map("nfse_cancelada")
  valorTotalNotaFiscal Decimal?        @map("valor_total_nota_fiscal") @db.Decimal(18, 6)
  sincronizadoEm       DateTime        @map("sincronizado_em")

  pedidos NotaFiscalPedido[]

  @@map("notas_fiscais")
}

// Tabela de ligacao N:N entre nota fiscal e pedido - uma nota pode
// referenciar mais de um pedido (campo `pedidos[]` do WK Radar). Sem dados
// proprios alem das duas FKs, so a associacao em si.
model NotaFiscalPedido {
  notaFiscalId String @map("nota_fiscal_id")
  pedidoId     String @map("pedido_id")

  notaFiscal NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  pedido     Pedido     @relation(fields: [pedidoId], references: [id])

  @@id([notaFiscalId, pedidoId])
  @@index([pedidoId])
  @@map("nota_fiscal_pedidos")
}

// Sincronizado do Estoque.svc (SOAP/WCF, operacao BuscarSaldoProduto) - so
// Estoque Proprio (EP), sem quebra por local de estocagem/filial (decisao
// de escopo desta OS, item "fora de escopo" com o gestor). Chave de upsert
// e codigoProduto (nao ha id proprio no retorno do servico) - casado por
// VALOR contra Produto.codigo, igual a logica que EstoqueService ja usava
// pra resolver identificador antes desta OS (nao e FK: Estoque.svc pode
// retornar um codigo sem produto sincronizado ainda, e nao deve bloquear a
// gravacao do saldo por isso).
model SaldoEstoque {
  id                   String   @id @default(uuid())
  codigoProduto        String   @unique @map("codigo_produto")
  quantidadeDisponivel Decimal  @map("quantidade_disponivel") @db.Decimal(18, 6)
  atualizadoEm         DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("saldos_estoque")
}

enum TipoCadenciaSync {
  INCREMENTAL
  INCREMENTAL_NOTURNO
  JANELA_FIXA_DIARIA
  CONFIGURAVEL

  @@map("tipo_cadencia_sync")
}

// Config editavel em runtime pra QUALQUER entidade sincronizada (OS
// BACKEND-15 - generaliza o que a OS anterior criou so pra saldo_estoque,
// ver SyncConfigService/AdminSyncController). 1 linha por nomeEntidade -
// entidade sem linha aqui cai no fallback fixo (@Cron de SyncScheduler,
// ver sync.scheduler.ts). tipoCadencia decide quais dos outros campos sao
// usados (intervaloMinutos para INCREMENTAL/CONFIGURAVEL, horarioFixo/
// diasSemana para INCREMENTAL_NOTURNO/JANELA_FIXA_DIARIA) - ver
// construir-repeat-options.ts pra conversao pro formato do BullMQ.
model ConfiguracaoSync {
  id                        String           @id @default(uuid())
  nomeEntidade              String           @unique @map("nome_entidade")
  tipoCadencia              TipoCadenciaSync @map("tipo_cadencia")
  intervaloMinutos          Int?             @map("intervalo_minutos")
  // Formato "HH:mm".
  horarioFixo               String?          @map("horario_fixo")
  // 0=domingo..6=sabado; vazio = todos os dias.
  diasSemana                Int[]            @map("dias_semana")
  // Tamanho da janela retroativa reprocessada a cada execucao, em DIAS
  // (OS-BACKEND-38) - campo distinto de cadencia (com que frequencia roda),
  // este e' QUANTO PASSADO cada execucao reprocessa. So faz sentido pra
  // entidades sem cursor incremental de alteracao (hoje so nota-fiscal, ver
  // NotaFiscalSyncStrategy) - null = usa o padrao hardcoded da propria
  // strategy (60 dias pra nota-fiscal). Nao e' generico o suficiente pra
  // toda entidade (cliente/produto/pedido tem cursor incremental de
  // verdade, esse conceito nao se aplica a eles), mas fica no mesmo lugar
  // de config generalizada em vez de uma tabela so pra nota-fiscal.
  janelaReprocessamentoDias Int?             @map("janela_reprocessamento_dias")
  atualizadoEm              DateTime         @updatedAt @map("atualizado_em")

  @@map("configuracao_sync")
}

// Identidade local minima (OS-BACKEND-19) - ate aqui o backend so conhecia
// o usuario via claims do JWT do IdP (sub/email/name, ver @CurrentUser()),
// sem tabela propria. DispositivoUsuario/ProdutoFavorito precisam de FK de
// verdade, nao de uma string solta - upsert por `sub` na primeira vez que
// o usuario bate num endpoint desta OS (ver UsuariosService).
model Usuario {
  id           String   @id @default(uuid())
  sub          String   @unique
  email        String
  nome         String
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  dispositivos           DispositivoUsuario[]
  favoritos              ProdutoFavorito[]
  vendedores             Vendedor[]
  localizacoes           LocalizacaoUsuario[]
  acoesFilaProcessadas   AcaoFilaProcessada[]
  historicoStatusPedidos PedidoHistoricoStatus[]
  documentosEnviados     Documento[]

  @@map("usuarios")
}

enum PlataformaDispositivo {
  ANDROID
  IOS
  WEB

  @@map("plataforma_dispositivo")
}

// Token de push (FCM) - chave de upsert e' o token em si (nao
// usuarioId+plataforma), porque cada instalacao do app/aparelho tem um
// token proprio e distinto; um mesmo usuario pode ter varios (celular +
// tablet).
model DispositivoUsuario {
  id           String                @id @default(uuid())
  usuarioId    String                @map("usuario_id")
  token        String                @unique
  plataforma   PlataformaDispositivo
  atualizadoEm DateTime              @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("dispositivos_usuario")
}

// Pre-requisito minimo pro alerta de "produto reabastecido" fazer sentido
// (ver SaldoEstoqueSyncStrategy/NotificacaoDispatchService) - sem isso nao
// haveria como saber quem quer ser avisado sobre qual produto.
model ProdutoFavorito {
  usuarioId String   @map("usuario_id")
  produtoId String   @map("produto_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, produtoId])
  @@map("produtos_favoritos")
}

enum TipoEventoNotificacao {
  PEDIDO_SITUACAO_ALTERADA
  NOTA_FISCAL_REJEITADA
  PRODUTO_REABASTECIDO
  // Extensao pos-OS-BACKEND-28 - vendedor cancelou um check-in de visita,
  // avisa o supervisor DIRETO (nao broadcast, ver
  // NotificacaoDispatchService.resolverTokensAlvo).
  VISITA_CANCELADA
  // Extensao pos-OS-BACKEND-22 (OS-MOBILE-26) - fecha o ciclo de aprovacao
  // de desconto com notificacao direta (nao broadcast, mesmo criterio de
  // VISITA_CANCELADA): CRIADA avisa o aprovador esperado (supervisor/
  // gerente), DECIDIDA avisa de volta o vendedor solicitante.
  SOLICITACAO_DESCONTO_CRIADA
  SOLICITACAO_DESCONTO_DECIDIDA

  @@map("tipo_evento_notificacao")
}

enum StatusEventoNotificacao {
  PENDENTE
  ENVIADO
  ERRO

  @@map("status_evento_notificacao")
}

// Gravado pelas strategies de sync (pedido/nota-fiscal/saldo-estoque) ao
// detectar uma mudanca relevante (comparacao explicita com o valor
// anterior, dentro da mesma transacao do upsert - ver
// EventoNotificacaoService). Processado depois, de forma assincrona, por
// NotificacaoDispatchService (fila propria, separada da fila de sync, pra
// nao atrasar o cursor incremental).
model EventoNotificacao {
  id           String                  @id @default(uuid())
  tipo         TipoEventoNotificacao
  // id LOCAL (nao idExternoErp) do Pedido/NotaFiscal/Produto conforme o
  // tipo - quem le decide como interpretar, nao ha FK polimorfica no Prisma.
  referenciaId String                  @map("referencia_id")
  titulo       String
  corpo        String
  // Dados extra pro deep-link do app (ex: {"pedidoId": "..."}).
  dados        Json?
  status       StatusEventoNotificacao @default(PENDENTE)
  criadoEm     DateTime                @default(now()) @map("criado_em")
  processadoEm DateTime?               @map("processado_em")
  erro         Json?

  @@index([status])
  @@map("eventos_notificacao")
}

// Tabela singleton (1 linha, service garante) - config do provedor de LLM
// (OS-BACKEND-20), editavel em runtime via PATCH /admin/llm/configuracao.
// DESVIO DELIBERADO do padrao "credencial de servico externo = env var"
// usado no resto do projeto (WK_RADAR_*/WK_BI_*/FIREBASE_SERVICE_ACCOUNT_JSON)
// - pedido explicito do usuario ("deixe uma opcao de configuracao"), nao
// trocar por env var sem re-confirmar. apiKey NUNCA e' retornada em GET
// (so um booleano `apiKeyConfigurada`, ver ConfiguracaoLlmService).
model ConfiguracaoLlm {
  id           String   @id @default(uuid())
  // "openrouter" por enquanto (gateway OpenAI-compatible cobrindo
  // Claude/GPT/etc via o campo `modelo`) - string livre, nao enum, pra
  // nao exigir migration se um provedor novo entrar depois.
  provedor     String   @default("openrouter")
  apiKey       String?  @map("api_key")
  modelo       String   @default("anthropic/claude-opus-5")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_llm")
}

// Sincronizado do WK Radar (GET /empresarial/v1/vendedor) - so leitura, ver
// skill wk-radar-client. DIFERENTE de cliente/produto/pedido: o endpoint nao
// tem NENHUM filtro de data (nem cursor unico, nem par Inicial/Final -
// confirmado contra o swagger.json do ambiente de testes), entao nao ha
// sync incremental de verdade - VendedorSyncStrategy reprocessa a lista
// inteira a cada execucao (agendamento JANELA_FIXA_DIARIA, mesmo padrao de
// NotaFiscal, ver vendedor.sync.ts).
//
// Vinculo com Usuario (OS-BACKEND-21): usuarioId e' resolvido no upsert por
// correspondencia de e-mail (Vendedor.email x Usuario.email,
// case-insensitive) - NAO e' uma FK vinda do WK Radar, e' calculada aqui.
// Usuario so existe apos o primeiro login desse vendedor no app (ver
// UsuariosService.obterOuCriarPorSub), entao a maioria dos vendedores pode
// nao ter correspondencia na primeira sincronizacao - normal, reavaliado a
// cada full refresh noturno. semCorrespondenciaUsuario sinaliza esse caso
// explicitamente (mesmo padrao de Produto.incompleto/Cliente.incompleto
// pra flag de estado) em vez de so depender de usuarioId ser null, que
// tambem seria o estado antes de qualquer tentativa de vinculo.
model Vendedor {
  id                        String   @id @default(uuid())
  idExternoErp              String   @unique @map("id_externo_erp")
  codigoIntegrador          String?  @map("codigo_integrador")
  codigo                    String?
  nome                      String?
  email                     String?
  inativo                   Boolean  @default(false)
  usuarioId                 String?  @map("usuario_id")
  semCorrespondenciaUsuario Boolean  @default(true) @map("sem_correspondencia_usuario")
  sincronizadoEm            DateTime @map("sincronizado_em")

  // Hierarquia (OS-BACKEND-22) - NAO vem do WK Radar (endpoint /vendedor nao
  // tem esses campos, ver skill wk-radar-client), configurada manualmente
  // pelo admin via PATCH /admin/vendedores/:id/hierarquia. papel default
  // VENDEDOR (nivel mais baixo) ate' alguem configurar diferente - nunca
  // fica sem valor, so sem hierarquia (supervisorId null) ate' ser setada.
  papel        PapelVendedor @default(VENDEDOR)
  supervisorId String?       @map("supervisor_id")
  supervisor   Vendedor?     @relation("HierarquiaVendedor", fields: [supervisorId], references: [id])
  subordinados Vendedor[]    @relation("HierarquiaVendedor")

  // true quando esta linha foi criada como stub por ClienteSyncStrategy
  // (OS-BACKEND-23, detalhes.idVendedores referenciando um vendedor ainda
  // nao sincronizado) - mesmo padrao de Produto/Cliente/Pedido.incompleto
  // (OS 06/07). VendedorSyncStrategy sempre grava false ao completar os
  // dados de verdade no proximo full refresh.
  incompleto Boolean @default(false)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  clientes ClienteVendedor[]

  solicitacoesSolicitadas     SolicitacaoDesconto[] @relation("SolicitacaoVendedorSolicitante")
  solicitacoesParaAprovar     SolicitacaoDesconto[] @relation("SolicitacaoAprovadorEsperado")
  solicitacoesDecididas       SolicitacaoDesconto[] @relation("SolicitacaoAprovador")
  pedidosCriados              Pedido[]
  visitas                     Visita[]
  clientesLocalizacaoDefinida Cliente[]             @relation("ClienteLocalizacaoDefinidaPor")
  metas                       MetaVendedor[]
  coberturasComoOriginal      CoberturaTemporaria[] @relation("CoberturaVendedorOriginal")
  coberturasComoSubstituto    CoberturaTemporaria[] @relation("CoberturaVendedorSubstituto")

  @@map("vendedores")
}

enum PapelVendedor {
  VENDEDOR
  SUPERVISOR
  GERENTE

  @@map("papel_vendedor")
}

// Meta mensal por vendedor (OS-BACKEND-44) - configurada manualmente pelo
// admin/supervisor (nao vem do Radar, mesmo motivo estrutural de
// Vendedor.papel/supervisorId acima: e' decisao de gestao interna, sem
// endpoint equivalente no ERP). mesAno como string "YYYY-MM" (nao DateTime)
// - representa um MES inteiro, nao um instante; evita ambiguidade de fuso
// horario na comparacao "qual mes e' esse timestamp" que um DateTime
// exigiria a cada leitura.
model MetaVendedor {
  id           String   @id @default(uuid())
  vendedorId   String   @map("vendedor_id")
  mesAno       String   @map("mes_ano")
  valorMeta    Decimal  @map("valor_meta") @db.Decimal(18, 6)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@unique([vendedorId, mesAno])
  @@map("metas_vendedor")
}

// Substituicao temporaria de carteira (OS-BACKEND-48) - enquanto ativa
// (dataInicio <= agora <= dataFim), o escopo de clientes do substituto
// (VendedorEscopoService) passa a incluir tambem a carteira do original,
// alem da propria. Configurada manualmente (admin), nao vem do Radar -
// mesmo motivo estrutural de Vendedor.papel/supervisorId. Fim automatico
// e' so' a passagem de dataFim - nenhum job precisa "desligar" nada, o
// escopo so consulta coberturas com a data ainda dentro da janela.
model CoberturaTemporaria {
  id                   String   @id @default(uuid())
  vendedorOriginalId   String   @map("vendedor_original_id")
  vendedorSubstitutoId String   @map("vendedor_substituto_id")
  dataInicio           DateTime @map("data_inicio")
  dataFim              DateTime @map("data_fim")
  criadoEm             DateTime @default(now()) @map("criado_em")

  vendedorOriginal   Vendedor @relation("CoberturaVendedorOriginal", fields: [vendedorOriginalId], references: [id], onDelete: Cascade)
  vendedorSubstituto Vendedor @relation("CoberturaVendedorSubstituto", fields: [vendedorSubstitutoId], references: [id], onDelete: Cascade)

  @@index([vendedorSubstitutoId, dataInicio, dataFim])
  @@map("coberturas_temporarias")
}

// Singleton (1 linha, mesmo padrao de ConfiguracaoDesconto/ConfiguracaoLlm)
// - flag de visibilidade do ranking de equipe (OS-BACKEND-44): decisao do
// supervisor/gerente se o VENDEDOR comum enxerga o ranking da propria
// equipe ou so a supervisao. false por padrao (fail-closed - nao expor
// comparativo entre colegas ate' alguem decidir habilitar).
model ConfiguracaoGamificacao {
  id                         String   @id @default(uuid())
  rankingVisivelParaVendedor Boolean  @default(false) @map("ranking_visivel_para_vendedor")
  atualizadoEm               DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_gamificacao")
}

// Tabela singleton (1 linha, service garante) - limite de desconto que
// dispara aprovacao (OS-BACKEND-22). DESVIO DELIBERADO do padrao
// "credencial de servico externo = env var": aqui e' regra de negocio, nao
// credencial, e o proprio texto da OS pede "para poder ajustar sem
// deploy" - por isso fica em tabela (mesmo padrao estrutural de
// ConfiguracaoLlm), editavel via PATCH /admin/configuracao-desconto, nao
// env var. Valor UNICO global (nao por papel) - decisao confirmada com o
// usuario: o criterio de aceite fala em "desconto acima de X%" sem
// distinguir o papel de quem solicita.
model ConfiguracaoDesconto {
  id               String   @id @default(uuid())
  limitePercentual Decimal  @default(20) @map("limite_percentual") @db.Decimal(5, 2)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_desconto")
}

enum StatusSolicitacaoDesconto {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("status_solicitacao_desconto")
}

// pedidoId aponta pro Pedido sincronizado do ERP (so leitura, OS 07) -
// PLACEHOLDER deliberado ate' a OS-BACKEND-25 trazer o conceito de "pedido
// rascunho" mencionado no texto desta OS; por isso e' nullable e nao
// "pedido" no sentido de uma venda ja fechada. Decisao confirmada com o
// usuario em vez de bloquear esta OS esperando a 25 existir - revisitar
// quando o rascunho for modelado.
//
// papelExigido e' calculado UMA VEZ na criacao (SolicitacaoDesconto.
// calcularPapelExigido, ver domain/solicitacao-desconto.entity.ts) e
// congelado aqui - mudar a hierarquia do vendedor DEPOIS de uma solicitacao
// criada nao deve alterar quem pode decidir uma solicitacao ja em aberto.
// aprovadorEsperadoId e' so informativo (quem a hierarquia aponta HOJE
// como aprovador direto) - a autorizacao de fato compara o papel de quem
// chama /aprovar contra papelExigido (ver SolicitacoesDescontoService),
// permitindo que qualquer papel suficiente decida, nao so a pessoa exata.
model SolicitacaoDesconto {
  id                    String                    @id @default(uuid())
  pedidoId              String?                   @map("pedido_id")
  percentualSolicitado  Decimal                   @map("percentual_solicitado") @db.Decimal(5, 2)
  vendedorSolicitanteId String                    @map("vendedor_solicitante_id")
  papelExigido          PapelVendedor             @map("papel_exigido")
  aprovadorEsperadoId   String?                   @map("aprovador_esperado_id")
  status                StatusSolicitacaoDesconto @default(PENDENTE)
  aprovadorId           String?                   @map("aprovador_id")
  decididoEm            DateTime?                 @map("decidido_em")
  criadoEm              DateTime                  @default(now()) @map("criado_em")

  pedido              Pedido?   @relation(fields: [pedidoId], references: [id])
  vendedorSolicitante Vendedor  @relation("SolicitacaoVendedorSolicitante", fields: [vendedorSolicitanteId], references: [id])
  aprovadorEsperado   Vendedor? @relation("SolicitacaoAprovadorEsperado", fields: [aprovadorEsperadoId], references: [id])
  aprovador           Vendedor? @relation("SolicitacaoAprovador", fields: [aprovadorId], references: [id])

  @@index([vendedorSolicitanteId])
  @@index([status])
  @@map("solicitacoes_desconto")
}

// Rastreio de localizacao em LOTE (OS-BACKEND-27) - nunca tempo real. O
// app captura pontos localmente (intervalo controlado do lado do app,
// OS-MOBILE-20) e envia em lote via POST /rastreio/lote, inclusive apos
// periodo offline - por isso capturadoEm (timestamp de quando o ponto foi
// capturado NO DISPOSITIVO) e recebidoEm (quando o servidor recebeu) sao
// campos DIFERENTES e podem estar bem distantes um do outro (criterio de
// aceite: usa o timestamp original, nao o momento do envio). loteId
// correlaciona todos os pontos de uma mesma chamada POST (nao e' FK pra
// lugar nenhum, so agrupamento).
model LocalizacaoUsuario {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  capturadoEm DateTime @map("capturado_em")
  loteId      String   @map("lote_id")
  recebidoEm  DateTime @default(now()) @map("recebido_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, capturadoEm])
  @@map("localizacoes_usuario")
}

// Check-in/checkout de visita (OS-BACKEND-28) - evento DELIBERADO do
// vendedor ("estou numa visita agora"), diferente do rastreio continuo e
// passivo de LocalizacaoUsuario (OS-BACKEND-27, ver comentario la). Sem
// vinculo automatico com Pedido criado depois (Escopo/Fora de escopo desta
// OS - correlacao fica visual/manual, nunca inferida aqui).
//
// checkoutEm null = visita em aberto. Um vendedor so pode ter UMA visita
// aberta por vez (criterio de aceite, decisao confirmada com o usuario:
// novo check-in com visita aberta e' BLOQUEADO com erro claro, nunca
// fecha a anterior sozinho - ver VisitasService.checkin).
model Visita {
  id          String    @id @default(uuid())
  clienteId   String    @map("cliente_id")
  vendedorId  String    @map("vendedor_id")
  checkinEm   DateTime  @map("checkin_em")
  checkinLat  Decimal   @map("checkin_lat") @db.Decimal(9, 6)
  checkinLng  Decimal   @map("checkin_lng") @db.Decimal(9, 6)
  checkoutEm  DateTime? @map("checkout_em")
  checkoutLat Decimal?  @map("checkout_lat") @db.Decimal(9, 6)
  checkoutLng Decimal?  @map("checkout_lng") @db.Decimal(9, 6)
  // Nota livre - pode ser preenchida no check-in e/ou sobrescrita no
  // checkout (VisitasService.checkout so atualiza se uma nova nota vier).
  nota        String?

  // Cancelamento (extensao pos-OS-BACKEND-28) - vendedor errou o cliente e
  // cancela ANTES do checkout, com comentario obrigatorio repassado ao
  // supervisor direto via push (ver VisitasService.cancelar,
  // TipoEventoNotificacao.VISITA_CANCELADA). Visita cancelada nunca tem
  // checkoutEm - canceladaEm e' o que marca "nao esta mais em aberto"
  // pro bloqueio de check-in duplo (ver VisitasService.checkin).
  canceladaEm        DateTime? @map("cancelada_em")
  motivoCancelamento String?   @map("motivo_cancelamento")

  // Foto da fachada (extensao pos-OS-BACKEND-28) - obrigatoria no
  // check-in, guardada em disco local (ver VisitaFotoStorageService).
  // distanciaCheckinMetros/distanciaCheckoutMetros sao a distancia REAL
  // calculada no momento (Cliente.localizacaoLat/Lng pode mudar depois -
  // guardar o valor calculado preserva o que foi validado na hora, nao um
  // numero que se tornaria inconsistente com o pin atual).
  fotoCheckinCaminho      String?  @map("foto_checkin_caminho")
  distanciaCheckinMetros  Decimal? @map("distancia_checkin_metros") @db.Decimal(10, 2)
  distanciaCheckoutMetros Decimal? @map("distancia_checkout_metros") @db.Decimal(10, 2)

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([clienteId])
  @@index([vendedorId, checkoutEm])
  @@map("visitas")
}

// Idempotencia da fila de acoes offline (OS-BACKEND-29) - idLocal e'
// gerado no DISPOSITIVO (nao aqui), a chave que garante que reenviar a
// mesma acao (retry de rede no meio do envio) nunca duplica o efeito no
// backend. @@unique([usuarioId, idLocal]) escopado por usuario (nao
// globalmente unico) - suficiente pro proposito (nunca faria sentido o
// MESMO idLocal, gerado no MESMO dispositivo/sessao de um vendedor,
// aparecer legitimamente pra outro usuario) e evita depender de um UUID
// verdadeiramente global nunca colidir.
model AcaoFilaProcessada {
  id           String         @id @default(uuid())
  usuarioId    String         @map("usuario_id")
  idLocal      String         @map("id_local")
  tipo         TipoAcaoFila
  status       StatusAcaoFila
  // resultado/erro sao a resposta CONGELADA na primeira execucao - um
  // reenvio do mesmo idLocal devolve isso de novo, sem re-executar nada
  // (ver FilaPendenteService.processarUma).
  resultado    Json?
  erro         String?
  processadoEm DateTime       @default(now()) @map("processado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, idLocal])
  @@map("acoes_fila_processadas")
}

enum TipoAcaoFila {
  CRIAR_PEDIDO
  CHECKIN_VISITA
  CHECKOUT_VISITA
  CANCELAR_VISITA
  RASTREIO_LOTE

  @@map("tipo_acao_fila")
}

enum StatusAcaoFila {
  SUCESSO
  ERRO

  @@map("status_acao_fila")
}

// Documentos institucionais pra consulta do vendedor (OS-BACKEND-41/
// OS-MOBILE-34/OS-WEB-38) - tabelas, catalogos, politicas comerciais.
// Armazenamento em disco local (volume persistente no docker-compose),
// mesma decisao ja tomada pra foto de check-in de visita (ver
// VisitaFotoStorageService) - nao introduz dependencia de object storage
// agora, arquivo institucional nao e' critico em volume.
model Documento {
  id            String   @id @default(uuid())
  nome          String
  categoria     String
  caminhoArquivo String  @map("caminho_arquivo")
  tipoMime      String   @map("tipo_mime")
  tamanhoBytes  Int      @map("tamanho_bytes")
  enviadoPorId  String   @map("enviado_por_id")
  criadoEm      DateTime @default(now()) @map("criado_em")

  enviadoPor Usuario @relation(fields: [enviadoPorId], references: [id])

  @@index([categoria])
  @@map("documentos")
}
