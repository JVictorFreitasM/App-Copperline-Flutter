enum StatusSolicitacaoDesconto {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("status_solicitacao_desconto")
}

// pedidoId aponta pro Pedido sincronizado do ERP (so leitura, OS 07) -
// PLACEHOLDER deliberado ate' a OS-BACKEND-25 trazer o conceito de "pedido
// rascunho" mencionado no texto desta OS; por isso e' nullable e nao
// "pedido" no sentido de uma venda ja fechada. Decisao confirmada com o
// usuario em vez de bloquear esta OS esperando a 25 existir - revisitar
// quando o rascunho for modelado.
//
// papelExigido e' calculado UMA VEZ na criacao (SolicitacaoDesconto.
// calcularPapelExigido, ver domain/solicitacao-desconto.entity.ts) e
// congelado aqui - mudar a hierarquia do vendedor DEPOIS de uma solicitacao
// criada nao deve alterar quem pode decidir uma solicitacao ja em aberto.
// aprovadorEsperadoId e' so informativo (quem a hierarquia aponta HOJE
// como aprovador direto) - a autorizacao de fato compara o papel de quem
// chama /aprovar contra papelExigido (ver SolicitacoesDescontoService),
// permitindo que qualquer papel suficiente decida, nao so a pessoa exata.
model SolicitacaoDesconto {
  id                    String                    @id @default(uuid())
  pedidoId              String?                   @map("pedido_id")
  percentualSolicitado  Decimal                   @map("percentual_solicitado") @db.Decimal(5, 2)
  vendedorSolicitanteId String                    @map("vendedor_solicitante_id")
  papelExigido          PapelVendedor             @map("papel_exigido")
  aprovadorEsperadoId   String?                   @map("aprovador_esperado_id")
  status                StatusSolicitacaoDesconto @default(PENDENTE)
  aprovadorId           String?                   @map("aprovador_id")
  decididoEm            DateTime?                 @map("decidido_em")
  criadoEm              DateTime                  @default(now()) @map("criado_em")

  pedido              Pedido?   @relation(fields: [pedidoId], references: [id])
  vendedorSolicitante Vendedor  @relation("SolicitacaoVendedorSolicitante", fields: [vendedorSolicitanteId], references: [id])
  aprovadorEsperado   Vendedor? @relation("SolicitacaoAprovadorEsperado", fields: [aprovadorEsperadoId], references: [id])
  aprovador           Vendedor? @relation("SolicitacaoAprovador", fields: [aprovadorId], references: [id])

  @@index([vendedorSolicitanteId])
  @@index([status])
  @@map("solicitacoes_desconto")
}

// Rastreio de localizacao em LOTE (OS-BACKEND-27) - nunca tempo real. O
// app captura pontos localmente (intervalo controlado do lado do app,
// OS-MOBILE-20) e envia em lote via POST /rastreio/lote, inclusive apos
// periodo offline - por isso capturadoEm (timestamp de quando o ponto foi
// capturado NO DISPOSITIVO) e recebidoEm (quando o servidor recebeu) sao
// campos DIFERENTES e podem estar bem distantes um do outro (criterio de
// aceite: usa o timestamp original, nao o momento do envio). loteId
// correlaciona todos os pontos de uma mesma chamada POST (nao e' FK pra
// lugar nenhum, so agrupamento).
model LocalizacaoUsuario {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  capturadoEm DateTime @map("capturado_em")
  loteId      String   @map("lote_id")
  recebidoEm  DateTime @default(now()) @map("recebido_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, capturadoEm])
  @@map("localizacoes_usuario")
}

// Check-in/checkout de visita (OS-BACKEND-28) - evento DELIBERADO do
// vendedor ("estou numa visita agora"), diferente do rastreio continuo e
// passivo de LocalizacaoUsuario (OS-BACKEND-27, ver comentario la). Sem
// vinculo automatico com Pedido criado depois (Escopo/Fora de escopo desta
// OS - correlacao fica visual/manual, nunca inferida aqui).
//
// checkoutEm null = visita em aberto. Um vendedor so pode ter UMA visita
// aberta por vez (criterio de aceite, decisao confirmada com o usuario:
// novo check-in com visita aberta e' BLOQUEADO com erro claro, nunca
// fecha a anterior sozinho - ver VisitasService.checkin).
model Visita {
  id          String    @id @default(uuid())
  clienteId   String    @map("cliente_id")
  vendedorId  String    @map("vendedor_id")
  checkinEm   DateTime  @map("checkin_em")
  // Nullable desde o Epico 4 (config-aba-rastreio.jpg,
  // "permitirRegistroComGpsDesabilitado") - null so quando essa config
  // permitiu o registro sem GPS (ver VisitasService.checkin); nunca null
  // por omissao acidental, o DTO valida isso antes.
  checkinLat  Decimal?  @map("checkin_lat") @db.Decimal(9, 6)
  checkinLng  Decimal?  @map("checkin_lng") @db.Decimal(9, 6)
  checkoutEm  DateTime? @map("checkout_em")
  checkoutLat Decimal?  @map("checkout_lat") @db.Decimal(9, 6)
  checkoutLng Decimal?  @map("checkout_lng") @db.Decimal(9, 6)
  // Nota livre - pode ser preenchida no check-in e/ou sobrescrita no
  // checkout (VisitasService.checkout so atualiza se uma nova nota vier).
  nota        String?

  // Cancelamento (extensao pos-OS-BACKEND-28) - vendedor errou o cliente e
  // cancela ANTES do checkout, com comentario obrigatorio repassado ao
  // supervisor direto via push (ver VisitasService.cancelar,
  // TipoEventoNotificacao.VISITA_CANCELADA). Visita cancelada nunca tem
  // checkoutEm - canceladaEm e' o que marca "nao esta mais em aberto"
  // pro bloqueio de check-in duplo (ver VisitasService.checkin).
  canceladaEm        DateTime? @map("cancelada_em")
  motivoCancelamento String?   @map("motivo_cancelamento")

  // Foto da fachada (extensao pos-OS-BACKEND-28) - obrigatoria no
  // check-in, guardada em disco local (ver VisitaFotoStorageService).
  // distanciaCheckinMetros/distanciaCheckoutMetros sao a distancia REAL
  // calculada no momento (Cliente.localizacaoLat/Lng pode mudar depois -
  // guardar o valor calculado preserva o que foi validado na hora, nao um
  // numero que se tornaria inconsistente com o pin atual).
  fotoCheckinCaminho      String?  @map("foto_checkin_caminho")
  distanciaCheckinMetros  Decimal? @map("distancia_checkin_metros") @db.Decimal(10, 2)
  distanciaCheckoutMetros Decimal? @map("distancia_checkout_metros") @db.Decimal(10, 2)

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([clienteId])
  @@index([vendedorId, checkoutEm])
  @@map("visitas")
}

// Idempotencia da fila de acoes offline (OS-BACKEND-29) - idLocal e'
// gerado no DISPOSITIVO (nao aqui), a chave que garante que reenviar a
// mesma acao (retry de rede no meio do envio) nunca duplica o efeito no
// backend. @@unique([usuarioId, idLocal]) escopado por usuario (nao
// globalmente unico) - suficiente pro proposito (nunca faria sentido o
// MESMO idLocal, gerado no MESMO dispositivo/sessao de um vendedor,
// aparecer legitimamente pra outro usuario) e evita depender de um UUID
// verdadeiramente global nunca colidir.
model AcaoFilaProcessada {
  id           String         @id @default(uuid())
  usuarioId    String         @map("usuario_id")
  idLocal      String         @map("id_local")
  tipo         TipoAcaoFila
  status       StatusAcaoFila
  // resultado/erro sao a resposta CONGELADA na primeira execucao - um
  // reenvio do mesmo idLocal devolve isso de novo, sem re-executar nada
  // (ver FilaPendenteService.processarUma).
  resultado    Json?
  erro         String?
  // SHA-256 do conteudo recebido na primeira execucao (ver hash-acao.ts) -
  // base do ack: reenvio do mesmo idLocal devolve este hash, e conteudo
  // diferente com o mesmo idLocal e' detectado como conflito.
  payloadHash  String?        @map("payload_hash")
  processadoEm DateTime       @default(now()) @map("processado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, idLocal])
  @@map("acoes_fila_processadas")
}

enum TipoAcaoFila {
  CRIAR_PEDIDO
  CHECKIN_VISITA
  CHECKOUT_VISITA
  CANCELAR_VISITA
  RASTREIO_LOTE

  @@map("tipo_acao_fila")
}

enum StatusAcaoFila {
  SUCESSO
  ERRO

  @@map("status_acao_fila")
}

// Documentos institucionais pra consulta do vendedor (OS-BACKEND-41/
// OS-MOBILE-34/OS-WEB-38) - tabelas, catalogos, politicas comerciais.
// Armazenamento em disco local (volume persistente no docker-compose),
// mesma decisao ja tomada pra foto de check-in de visita (ver
// VisitaFotoStorageService) - nao introduz dependencia de object storage
// agora, arquivo institucional nao e' critico em volume.
model Documento {
  id             String   @id @default(uuid())
  nome           String
  categoria      String
  caminhoArquivo String   @map("caminho_arquivo")
  tipoMime       String   @map("tipo_mime")
  tamanhoBytes   Int      @map("tamanho_bytes")
  enviadoPorId   String   @map("enviado_por_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  enviadoPor Usuario @relation(fields: [enviadoPorId], references: [id])

  @@index([categoria])
  @@map("documentos")
}

// Sincronizado do WK Radar (GET /empresarial/v1/forma-pagamento) - so
// leitura. Catalogo pequeno e estavel (~17 registros) - sem filtro de
// "alterado desde" no endpoint, mesmo padrao de Vendedor: full refresh
// diario, busca Situacao=Todos e guarda o proprio flag `inativa` (nao
// filtra Situacao=Ativos na sync) - assim uma forma que for desativada no
// Radar reflete aqui no proximo refresh, em vez de ficar "presa" com o
// ultimo valor sincronizado antes de virar inativa. Quem le decide
// mostrar so as ativas (decisao confirmada com o usuario: pedido so pode
// escolher forma de pagamento valida). Preparacao pro envio de pedido ao
// ERP (POST /comercial/v1/pedido, faturamento.parcelas[].idFormaPagamento)
// - ver OS-pendentes-claude-code.md.
model FormaPagamento {
  id                    String   @id @default(uuid())
  idExternoErp          String   @unique @map("id_externo_erp")
  codigo                String?
  descricao             String?
  inativa               Boolean  @default(false)
  // Override do admin (painel web, ativar/desativar), independente de
  // `inativa` (vem do Radar, sobrescrita a cada sync diario) - o upsert
  // de FormaPagamentoSyncStrategy nunca inclui este campo no `update`,
  // entao o sync nunca apaga essa escolha manual. Efetivamente
  // selecionavel na criacao de pedido so quando os dois forem false (ver
  // PagamentoService.listarFormasPagamento).
  desativadaManualmente Boolean  @default(false) @map("desativada_manualmente")
  sincronizadoEm        DateTime @map("sincronizado_em")

  pedidos Pedido[]

  @@map("formas_pagamento")
}

// Sincronizado do WK Radar (GET /empresarial/v1/condicao-pagamento,
// Modulos=ComercialECF - so a condicao usavel em venda, nao Compras) - so
// leitura, mesmo padrao de agendamento de FormaPagamento (sem cursor de
// alteracao, full refresh diario). O endpoint NAO tem filtro de
// "ativa"/"inativa" (diferente de FormaPagamento) - `validade` e' o unico
// sinal de vigencia (null = sem data de expiracao, sempre valida; alguma
// data = deixa de valer apos ela). Por isso sincroniza TUDO que o Radar
// retornar (nao filtra na sync) e quem le (CondicaoPagamentoService)
// decide o que mostrar como "ativa" comparando `validade` com a data
// atual - mesmo criterio de nao filtrar dado bruto demais cedo, decisao
// fica no service de leitura.
model CondicaoPagamento {
  id                    String    @id @default(uuid())
  idExternoErp          String    @unique @map("id_externo_erp")
  codigo                String?
  nome                  String?
  aVista                Boolean   @default(false) @map("a_vista")
  comEntrada            Boolean   @default(false) @map("com_entrada")
  antecipada            Boolean   @default(false)
  // Ate quando esta condicao pode ser usada - null = sem expiracao.
  validade              DateTime?
  // Parcelas nao tem identidade propria no WK Radar (so
  // percentual/prazo/idTipoVencimento) - mesmo criterio ja usado em
  // Cliente.enderecos: sem identidade propria pra preservar, JSONB e
  // suficiente.
  parcelas              Json      @default("[]")
  // Override do admin (painel web, ativar/desativar) - mesmo criterio de
  // FormaPagamento.desativadaManualmente: independente de `validade`,
  // nunca sobrescrito pelo sync (CondicaoPagamentoSyncStrategy.upsert nao
  // inclui este campo no `update`).
  desativadaManualmente Boolean   @default(false) @map("desativada_manualmente")
  sincronizadoEm        DateTime  @map("sincronizado_em")

  pedidos Pedido[]

  @@map("condicoes_pagamento")
}

// ---------------------------------------------------------------------------
// Mensagens manuais do admin pro app do vendedor (tela de Notificacoes do
// painel web). Grupos sao listas nomeadas de vendedores, mantidas na mesma
// tela - sem relacao com a hierarquia supervisor->vendedor (um grupo pode
// misturar equipes).
// ---------------------------------------------------------------------------
model GrupoMensagem {
  id           String   @id @default(uuid())
  nome         String   @unique
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  membros    GrupoMensagemMembro[]
  mensagens  MensagemNotificacao[]
  periodicas MensagemPeriodica[]

  @@map("grupos_mensagem")
}

model GrupoMensagemMembro {
  grupoId    String @map("grupo_id")
  vendedorId String @map("vendedor_id")

  grupo    GrupoMensagem @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  vendedor Vendedor      @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@id([grupoId, vendedorId])
  @@index([vendedorId])
  @@map("grupos_mensagem_membros")
}

enum DestinoMensagem {
  TODOS
  VENDEDOR
  GRUPO

  @@map("destino_mensagem")
}

model MensagemNotificacao {
  id                 String          @id @default(uuid())
  autorId            String          @map("autor_id")
  destino            DestinoMensagem
  vendedorId         String?         @map("vendedor_id")
  grupoId            String?         @map("grupo_id")
  assunto            String
  corpo              String
  totalDestinatarios Int             @map("total_destinatarios")
  // Preenchido quando o envio veio do agendamento (MensagemPeriodica) -
  // reenvio manual e envio avulso ficam null.
  periodicaId        String?         @map("periodica_id")
  criadoEm           DateTime        @default(now()) @map("criado_em")

  autor     Usuario            @relation(fields: [autorId], references: [id])
  vendedor  Vendedor?          @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  grupo     GrupoMensagem?     @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  periodica MensagemPeriodica? @relation(fields: [periodicaId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@map("mensagens_notificacao")
}

enum FrequenciaMensagem {
  DIARIA
  DIAS_UTEIS
  SEMANAL
  MENSAL

  @@map("frequencia_mensagem")
}

// Mensagem manual que o admin agenda pra repetir (ex: "toda segunda as 8h").
// Cada disparo cria uma MensagemNotificacao normal (historico, inbox e push
// iguais a um envio avulso), com periodicaId apontando pra ca. Horario em
// America/Sao_Paulo. proximoEnvioEm e' a unica fonte de "quando dispara" -
// o job de 1 em 1 minuto so procura ativas com proximoEnvioEm <= agora.
model MensagemPeriodica {
  id             String             @id @default(uuid())
  autorId        String             @map("autor_id")
  destino        DestinoMensagem
  vendedorId     String?            @map("vendedor_id")
  grupoId        String?            @map("grupo_id")
  assunto        String
  corpo          String
  frequencia     FrequenciaMensagem
  // "HH:mm" no fuso de Sao Paulo.
  horario        String
  // 0 (domingo) a 6 (sabado) - so SEMANAL.
  diaSemana      Int?               @map("dia_semana")
  // 1 a 31 - so MENSAL (mes mais curto cai no ultimo dia).
  diaMes         Int?               @map("dia_mes")
  ativa          Boolean            @default(true)
  proximoEnvioEm DateTime           @map("proximo_envio_em")
  ultimoEnvioEm  DateTime?          @map("ultimo_envio_em")
  // Motivo do ultimo disparo que nao enviou (ex: ninguem com app vinculado,
  // grupo removido) - null quando o ultimo disparo deu certo.
  ultimoErro     String?            @map("ultimo_erro")
  criadoEm       DateTime           @default(now()) @map("criado_em")
  atualizadoEm   DateTime           @updatedAt @map("atualizado_em")

  autor     Usuario               @relation(fields: [autorId], references: [id])
  vendedor  Vendedor?             @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  grupo     GrupoMensagem?        @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  mensagens MensagemNotificacao[]

  @@index([ativa, proximoEnvioEm])
  @@map("mensagens_periodicas")
}
