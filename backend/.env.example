DATABASE_URL="postgresql://postgres:postgres@localhost:5432/copperline?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000

SESSION_SECRET=troque-por-um-segredo-aleatorio
# Vazio em dev (localhost, cookie ja funciona entre portas). Em producao,
# se front/back forem subdominios diferentes, setar ex: .copperline.com.br
SESSION_COOKIE_DOMAIN=

IDP_URL=http://localhost:3000
IDP_CLIENT_ID=troque-pelo-client-id-registrado-no-idp
IDP_CLIENT_SECRET=troque-pelo-client-secret-registrado-no-idp
IDP_REDIRECT_URI=http://localhost:3000/auth/callback
# Destino pos-login quando nao ha `returnTo` salvo (login iniciado direto
# por um card no portal do IdP, nao por GET /auth/login desta app) - sem
# isso, o fallback da lib e' "/" relativo a este proprio backend.
FRONTEND_PUBLIC_URL=http://localhost:3020

ADMIN_API_KEY=troque-por-uma-chave-aleatoria

WK_RADAR_API_URL=http://troque-pelo-host-do-wk-radar
WK_RADAR_EMPRESA=troque-pela-empresa
WK_RADAR_USUARIO=troque-pelo-usuario
WK_RADAR_SENHA=troque-pela-senha
WK_RADAR_ID_INTEGRADOR=
WK_RADAR_REQUEST_TIMEOUT_MS=30000
WK_RADAR_JANELA_CLIENTE_MS=86400000
WK_RADAR_JANELA_PRODUTO_MS=21600000
WK_RADAR_MIN_REQUEST_INTERVAL_MS=300
WK_RADAR_JANELA_PEDIDO_MS=7200000
WK_RADAR_JANELA_NOTA_FISCAL_MS=86400000

# Data de inicio da carga inicial (primeira sincronizacao, sem cursor
# salvo ainda) - decisao de negocio, NUNCA deixar o codigo assumir "desde
# sempre" (ja causou incidente real: janela de dezenas de anos, o WK Radar
# nunca responde tudo isso). So usada quando ainda nao existe
# sync_entities.ultima_sincronizacao para a entidade; depois disso, o
# cursor incremental normal assume. Formato YYYY-MM-DD.
WK_RADAR_CLIENTE_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
WK_RADAR_PRODUTO_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
WK_RADAR_PEDIDO_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
# nomeEntidade da strategy e' 'saldo_estoque' (underscore, ver
# saldo-estoque.sync.ts) - a chave abaixo e' derivada disso, nao escolha
# livre.
WK_RADAR_SALDO_ESTOQUE_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
# vendedor (OS-BACKEND-21) nao tem cursor incremental (endpoint sem filtro
# de data) - VendedorSyncStrategy.fetch() ignora esse valor na pratica, mas
# SyncService.obterDesde() exige a variavel configurada em toda primeira
# sincronizacao, independente da strategy usar o valor ou nao. Qualquer
# data valida serve.
WK_RADAR_VENDEDOR_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio

# WK BI (Executivo.svc) - servico separado da API REST acima, usado so pro
# endpoint /estoque (OS-BACKEND-12). Usuario pode ser diferente do
# WK_RADAR_USUARIO (confirmar com quem administra o WK Radar).
WK_BI_URL=http://troque-pelo-host-do-wk-radar/RadarWebWebServices/Areas/Executivo/Executivo.svc/json
WK_BI_BASE=troque-pela-base
WK_BI_USUARIO=troque-pelo-usuario
WK_BI_SENHA=troque-pela-senha
WK_BI_REQUEST_TIMEOUT_MS=60000

# Hash do modelo de relatorio "Saldo de Produtos por Local de Estocagem -
# BOT" ja salvo no WK Radar - obter com quem administra o WK Radar, nunca
# hardcoded no codigo. Demais parametros do relatorio (Empresa, Modelo,
# Filial etc.) sao derivados/fixos em estoque.service.ts, confirmados
# contra o workflow n8n ja em producao - nao precisam de env var propria.
WK_BI_HASH_SALDO_ESTOQUE=troque-pelo-hash-do-relatorio

# Estoque.svc (SOAP/WCF) - sincronizacao periodica de saldo de estoque
# (substitui a consulta on-demand ao WK BI acima em /estoque). Servico
# diferente do WK BI (protocolo SOAP, nao JSON) mas mesmo servidor Radar -
# reaproveita WK_BI_BASE/WK_BI_USUARIO/WK_BI_SENHA/WK_BI_REQUEST_TIMEOUT_MS
# acima, nenhuma credencial nova.
WK_RADAR_ESTOQUE_SVC_URL=http://troque-pelo-host-do-wk-radar/RadarWebWebServices/Areas/Estoque/Estoque.svc/json/BuscarSaldoProduto

# Firebase Cloud Messaging (OS-BACKEND-19) - JSON do service account
# (Firebase Console > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada), serializado numa linha so. Sem isso, o app
# sobe normalmente mas o envio de push fica indisponivel (fail-closed,
# nunca hardcoded/adivinhado - ver PushNotificationClientService).
FIREBASE_SERVICE_ACCOUNT_JSON=troque-pelo-json-do-service-account-numa-linha-so

# Fotos de check-in de visita (extensao pos-OS-BACKEND-28) - disco local,
# decisao confirmada com o usuario. Em producao/docker, montar como volume
# persistente (ver docker-compose.yml) - senao a foto some a cada deploy.
VISITAS_FOTOS_DIR=./uploads/visitas
