# Segredos consumidos pelo docker-compose.yml (via variable substitution) -
# copiar pra .env e preencher antes de rodar `docker compose up`.

SESSION_SECRET=troque-por-um-segredo-aleatorio

IDP_CLIENT_ID=troque-pelo-client-id-registrado-no-idp
IDP_CLIENT_SECRET=troque-pelo-client-secret-registrado-no-idp

ADMIN_API_KEY=troque-por-uma-chave-aleatoria

WK_RADAR_API_URL=http://troque-pelo-host-do-wk-radar
WK_RADAR_EMPRESA=troque-pela-empresa
WK_RADAR_USUARIO=troque-pelo-usuario
WK_RADAR_SENHA=troque-pela-senha
WK_RADAR_ID_INTEGRADOR=

# Data de inicio da carga inicial (primeira sincronizacao, sem cursor
# salvo ainda) - decisao de negocio, ver backend/.env.example pro
# detalhe do porque isso existe.
WK_RADAR_CLIENTE_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
WK_RADAR_PRODUTO_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
WK_RADAR_PEDIDO_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio
WK_RADAR_SALDO_ESTOQUE_DATA_INICIO_CARGA=troque-pela-data-definida-com-o-negocio

# WK BI (Executivo.svc) - usuario pode ser diferente do WK_RADAR_USUARIO.
WK_BI_URL=http://troque-pelo-host-do-wk-radar/RadarWebWebServices/Areas/Executivo/Executivo.svc/json
WK_BI_BASE=troque-pela-empresa
WK_BI_USUARIO=troque-pelo-usuario
WK_BI_SENHA=troque-pela-senha
WK_BI_HASH_SALDO_ESTOQUE=troque-pelo-hash-do-relatorio
# 60s (nao 30s) - confirmado na pratica que o WK BI pode ser lento mesmo
# numa consulta de um unico produto.
WK_BI_REQUEST_TIMEOUT_MS=60000

# Estoque.svc (SOAP/WCF) - sincronizacao periodica de saldo de estoque,
# reaproveita as credenciais WK_BI_* acima (mesmo servidor Radar).
WK_RADAR_ESTOQUE_SVC_URL=http://troque-pelo-host-do-wk-radar/RadarWebWebServices/Areas/Estoque/Estoque.svc/json/BuscarSaldoProduto

# Financeiro.svc (SOAP/WCF, OS-BACKEND-36/OS-BACKEND-43) - URL BASE do
# servico (sem operacao no final - este client chama BuscarPosicaoFinanceira,
# BuscarTokenBoleto e DownloadBoleto, ver financeiro-svc-client.service.ts).
WK_RADAR_FINANCEIRO_SVC_URL=http://troque-pelo-host-do-wk-radar/RadarWebWebServices/Areas/Financeiro/Financeiro.svc/json

# Empresarial.svc (SOAP/WCF) - sincronizacao de tabela de preco,
# reaproveita as credenciais WK_BI_* acima (mesmo servidor Radar).
WK_RADAR_EMPRESARIAL_SVC_URL=http://troque-pelo-host-do-wk-radar/RadarWebWebServices/Areas/Empresarial/Empresarial.svc/json/BuscarTabelasPreco
# Confirmado empiricamente que o full refresh (todas as tabelas numa
# chamada so) leva ~90s do host, ~188s de dentro do container (rede do
# Docker mais lenta nesse ambiente) - 300s (5min) da margem real.
WK_RADAR_EMPRESARIAL_SVC_TIMEOUT_MS=300000
# Placeholder exigido por SyncService.obterDesde() na primeira sincronizacao
# - tabela-preco ignora esse valor na pratica (full refresh sempre).
WK_RADAR_TABELA_PRECO_DATA_INICIO_CARGA=2024-01-01
# Mesmo placeholder - forma-pagamento/condicao-pagamento tambem ignoram na
# pratica (full refresh sempre).
WK_RADAR_FORMA_PAGAMENTO_DATA_INICIO_CARGA=2024-01-01
WK_RADAR_CONDICAO_PAGAMENTO_DATA_INICIO_CARGA=2024-01-01

# Envio de pedido ao ERP (PedidoErpClientService) - valores fixos de
# referencia da empresa, confirmados empiricamente (nao adivinhados).
WK_RADAR_ID_FILIAL=16384
WK_RADAR_ID_UNIDADE_VENDA=229376

# Firebase Cloud Messaging - JSON do service account numa linha so. Sem
# isso o envio de push fica indisponivel (fail-closed).
FIREBASE_SERVICE_ACCOUNT_JSON=troque-pelo-json-do-service-account-numa-linha-so
